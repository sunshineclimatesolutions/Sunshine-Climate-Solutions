---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { getEntry } from 'astro:content';
import truckImage from '../content/site/images/work-truck.jpg';
import headshotImage from '../content/site/images/owner-headshot.jpg';
import { need } from '../lib/site-content';

const about = await getEntry('site', 'about');
if (!about) throw new Error('[content] src/content/site/about.md is missing');

const hero = need(about.data.hero, 'about.md → hero');
const intro = need(about.data.intro, 'about.md → intro');
const story = need(about.data.story, 'about.md → story');
const experience = need(about.data.experience, 'about.md → experience');
const owner = need(about.data.owner, 'about.md → owner');
const supportNote = need(about.data.supportNote, 'about.md → supportNote');
const ctaBand = need(about.data.ctaBand, 'about.md → ctaBand');

const title = about.data.metaTitle;
const description = about.data.metaDescription;

// Owner copy is authored as plain text with two inline conventions:
// **bold** and [label](href). Escape first, then apply only those patterns.
const escapeHtml = (text: string) =>
  text
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');

const renderInline = (text: string) =>
  escapeHtml(text)
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container page-hero-inner page-hero-inner--center">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="about-hero-heading">
        <Icon name="flag" class="hero-flag" size={72} viewBox="2.9 6.4 18.2 11.2" />
        <span>
          {(hero.heading ?? '').split('\n').map((line, index) => (
            <>
              {index > 0 && <br />}
              {line === 'with' ? <em>{line}</em> : line}
            </>
          ))}
        </span>
      </h1>
      <p class="lead">
        {hero.lead}
      </p>
    </div>
  </section>

  <!-- Field photographs: the working platform and the owner behind the profile. -->
  <section class="about-media-band">
    <div class="container">
      <div class="about-media-duo">
        <figure class="about-media about-media--portrait">
          <Image
            src={headshotImage}
            alt="Aaron Thomas, owner and operator of Sunshine Climate Solutions."
            widths={[400, 640, 800]}
            sizes="(min-width: 48em) 44vw, 96vw"
            loading="lazy"
            style="object-position: 50% 30%"
          />
          <figcaption>Aaron Thomas — Owner / Operator</figcaption>
        </figure>
        <figure class="about-media about-media--truck">
          <Image
            src={truckImage}
            alt="The company's white Ram 2500 service truck with SCS lettering, parked under Florida oaks in Spring Hill."
            widths={[640, 1000, 1400]}
            sizes="(min-width: 48em) 44vw, 96vw"
            loading="lazy"
            style="object-position: 50% 52%"
          />
          <figcaption>Sunshine Climate Solutions</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Owner-authored body: one lead title, subordinate sections, grouped
       customer-experience statements. Copy is preserved verbatim. -->
  <section class="section" aria-labelledby="about-intro-heading">
    <div class="container container--narrow">
      <div class="prose about-body">
        <h2 id="about-intro-heading" class="about-lead-heading">{intro.heading}</h2>
        {intro.paragraphs.map((paragraph) => <p set:html={renderInline(paragraph)} />)}

        {
          story.map((section) => (
            <>
              <h3 class="about-section-heading">{section.heading}</h3>
              {section.paragraphs.map((paragraph) => <p set:html={renderInline(paragraph)} />)}
            </>
          ))
        }

        <h3 class="about-section-heading">{experience.heading}</h3>
        <p>{experience.intro}</p>
        <blockquote class="about-experience-quotes">
          {experience.statements.map((statement) => <p>{statement}</p>)}
        </blockquote>
        <p set:html={renderInline(experience.closing)} />
      </div>
    </div>
  </section>

  <!-- Owner / credential facts — clean, brief, no résumé paragraph. -->
  <section class="section section--alt" aria-labelledby="about-owner-heading">
    <div class="container container--narrow">
      <div class="prose about-owner">
        <h2 id="about-owner-heading">{owner.name}</h2>
        <p class="about-owner-role">{owner.role}</p>
        <ul>
          {owner.credentials.map((item) => <li>{item}</li>)}
        </ul>
        {owner.footnote && <p class="about-owner-note">{owner.footnote}</p>}
      </div>
      <p class="about-support-note">
        {supportNote.lead} <a href="/support/">{supportNote.linkLabel}</a>
      </p>
    </div>
  </section>

  <CtaBand context="about" title={ctaBand.title} text={ctaBand.text} />
</BaseLayout>
