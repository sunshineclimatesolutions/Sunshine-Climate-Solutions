---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TrustChips from '../components/TrustChips.astro';
import CtaBand from '../components/CtaBand.astro';
import { getEntry } from 'astro:content';
import { business, licenseDisplay } from '../config/business';
import { need, interpolateBusiness } from '../lib/site-content';

const about = await getEntry('site', 'about');
if (!about) throw new Error('[content] src/content/site/about.md is missing');

const license = licenseDisplay();

const hero = need(about.data.hero, 'about.md → hero');
const infoTitles = need(about.data.infoTitles, 'about.md → infoTitles');
const story = need(about.data.story, 'about.md → story');
const ctaBand = need(about.data.ctaBand, 'about.md → ctaBand');

const title = about.data.metaTitle;
const description = about.data.metaDescription;
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container page-hero-inner page-hero-inner--center">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.heading}</h1>
      <p class="lead">
        {hero.lead}
      </p>
    </div>
  </section>

  <!-- Business information (license renders here once the owner configures it) -->
  <section class="section section--alt" aria-labelledby="about-business-heading">
    <div class="container">
      <h2 id="about-business-heading" class="visually-hidden">Business information</h2>
      <div class="about-cards">
        <div class="card">
          <h3 style="font-size: var(--text-lg);">{infoTitles.call}</h3>
          <p>
            <a href={business.phone.href} data-cta="call-about" class="text-link">
              <Icon name="phone" /> {business.phone.display}
            </a>
          </p>
          <p style="font-size: var(--text-sm);">
            <a href={business.phone.sms} data-cta="text-about" class="text-link">
              <Icon name="message" /> Text us
            </a>
          </p>
        </div>
        <div class="card">
          <h3 style="font-size: var(--text-lg);">{infoTitles.hours}</h3>
          <p>{business.hours.display}, {business.hours.days.toLowerCase()}.</p>
          <p style="font-size: var(--text-sm);">Timezone: US Eastern (America/New_York).</p>
        </div>
        <div class="card">
          <h3 style="font-size: var(--text-lg);">{infoTitles.area}</h3>
          <p>Hernando, Pasco, Pinellas, and Hillsborough counties — Tampa Bay and surrounding communities.</p>
        </div>
        <div class="card">
          <h3 style="font-size: var(--text-lg);">{infoTitles.pricing}</h3>
          <p>
            {business.pricing.serviceCall} service call, waived when you proceed with the repair ·
            Free estimates.
          </p>
          <p class="license-line" style="margin-top: var(--sp-2xs);">
            <Icon name="badge" /> Licensed and insured
            {license ? ` · ${license}` : ''}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-story-heading">
    <div class="container container--narrow">
      <div class="prose">
        {
          story.map((section, index) => (
            <>
              <h2 id={index === 0 ? 'about-story-heading' : undefined}>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{interpolateBusiness(paragraph)}</p>
              ))}
              {section.list.length > 0 && (
                <ul>
                  {section.list.map((item) => (
                    <li>{interpolateBusiness(item)}</li>
                  ))}
                </ul>
              )}
              {section.footnote && <p>{interpolateBusiness(section.footnote)}</p>}
            </>
          ))
        }
      </div>

      <div style="margin-top: var(--sp-lg);">
        <TrustChips />
      </div>
    </div>
  </section>

  <CtaBand context="about" title={ctaBand.title} text={ctaBand.text} />
</BaseLayout>
