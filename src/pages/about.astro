---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TrustChips from '../components/TrustChips.astro';
import CtaBand from '../components/CtaBand.astro';
import { business, licenseDisplay } from '../config/business';

// About story is managed in src/content/site/about.md (editable via Pages CMS).
const about = await getEntry('site', 'about');
if (!about) throw new Error('Missing src/content/site/about.md');
const { Content } = await render(about);

const license = licenseDisplay();
---

<BaseLayout title={about.data.metaTitle} description={about.data.metaDescription}>
  <section class="page-hero on-dark">
    <div class="container page-hero-inner">
      <p class="eyebrow">About</p>
      <h1>Owner-operated, on purpose</h1>
      {about.data.introLead && <p class="lead">{about.data.introLead}</p>}
    </div>
  </section>

  <!-- Business information (license renders here once the owner configures it) -->
  <section class="section section--alt" aria-labelledby="about-business-heading">
    <div class="container">
      <h2 id="about-business-heading" class="visually-hidden">Business information</h2>
      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));">
        <div class="card">
          <h3 style="font-size: var(--text-lg);">Call or text</h3>
          <p>
            <a href={business.phone.href} data-cta="call-about" class="text-link">
              <Icon name="phone" /> {business.phone.display}
            </a>
          </p>
          <p style="font-size: var(--text-sm);">
            <a href={business.phone.sms} data-cta="text-about" class="text-link">
              <Icon name="message" /> Text us
            </a>
          </p>
        </div>
        <div class="card">
          <h3 style="font-size: var(--text-lg);">Hours</h3>
          <p>{business.hours.display}, {business.hours.days.toLowerCase()}.</p>
          <p style="font-size: var(--text-sm);">Timezone: US Eastern (America/New_York).</p>
        </div>
        <div class="card">
          <h3 style="font-size: var(--text-lg);">Service area</h3>
          <p>Hernando, Pasco, Pinellas, and Hillsborough counties — Tampa Bay and surrounding communities.</p>
        </div>
        <div class="card">
          <h3 style="font-size: var(--text-lg);">Pricing</h3>
          <p>
            {business.pricing.serviceCall} service call, waived when you proceed with the repair ·
            Free estimates.
          </p>
          <p class="license-line" style="margin-top: var(--sp-2xs);">
            <Icon name="badge" /> Licensed and insured
            {license ? ` · ${license}` : ''}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-story-heading">
    <div class="container container--narrow">
      <h2 id="about-story-heading" class="visually-hidden">About Sunshine Climate Solutions</h2>
      <div class="prose">
        <Content />
      </div>

      <div style="margin-top: var(--sp-lg);">
        <TrustChips />
      </div>
    </div>
  </section>

  <CtaBand
    context="about"
    title="Work with the owner directly"
    text="Call, text, or send a request — you'll get clear answers and straight options, every time."
  />
</BaseLayout>
