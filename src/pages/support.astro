---
// /support/ — founder-led fundraising page. NOINDEX by design: it is a direct/
// social/email/referral destination, not a search-acquisition page.
//
// Architecture: narrative copy lives in src/content/site/support.md (validated
// by the site schema); fundraiser URLs come from business.fundraising; the
// budget amounts are structured numbers so the allocation bars and percentages
// are computed, never hand-drawn. Rules: never fabricate progress, donor
// counts, testimonials, outcomes, or promises of licensing/revenue; never imply
// tax deductibility, equity, repayment, service credit, or investment returns;
// no service-funnel CTAs on this page beyond the normal site chrome. Photo
// captions describe only what each photograph shows. The allocation is
// owner-approved.
//
// Video: business.fundraising.founderVideoUrl holds the SHORT WEBSITE
// INTRODUCTION only (45–75 s). The longer fundraiser presentation is a
// separate film for the fundraising platforms — see
// docs/marketing/SUPPORT-VIDEO-STRATEGY.md. The placeholder shows no image.
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import FaqItem from '../components/FaqItem.astro';
import { business } from '../config/business';
import { need } from '../lib/site-content';
import { youTubeEmbedUrl } from '../lib/video';

const supportEntry = await getEntry('site', 'support');
if (!supportEntry) throw new Error('[content] src/content/site/support.md is missing');
const s = need(supportEntry.data.support, 'support.md → support');

const title = supportEntry.data.metaTitle;
const description = supportEntry.data.metaDescription;

const gofundme = business.fundraising.gofundme;
const givesendgo = business.fundraising.givesendgo;
const founderVideoUrl = business.fundraising.founderVideoUrl.trim();
const founderVideoEmbedUrl = youTubeEmbedUrl(founderVideoUrl);
if (founderVideoUrl && !founderVideoEmbedUrl) {
  console.warn(
    '[support] business.fundraising.founderVideoUrl is set but is not a recognized YouTube watch/share link — showing the placeholder.',
  );
}

// The two authorized platform actions, reused in the hero and in the compact
// repeat after "Other Ways to Help".
const platformActions = [
  {
    key: 'givesendgo',
    href: givesendgo,
    label: 'Support on GiveSendGo',
    logo: '/images/givesendgo-logo.png',
    width: 573,
    height: 120,
  },
  {
    key: 'gofundme',
    href: gofundme,
    label: 'Support on GoFundMe',
    logo: '/images/gofundme-logo.webp',
    width: 349,
    height: 120,
  },
];

const total = s.budget.items.reduce((sum, item) => sum + item.amount, 0);
const fmt = (amount: number) => `$${amount.toLocaleString('en-US')}`;
// Exact percentage to one decimal (×1000/10 avoids binary rounding noise).
const shareOf = (amount: number) => (amount * 1000) / total / 10;
const fmtShare = (share: number) => `${Number.isInteger(share) ? share : share.toFixed(1)}%`;
---

<BaseLayout title={title} description={description} noindex={true}>
  <div class="support-page">
    <!-- ── 1. Hero: the owner's message + the fundraising goal ────────────── -->
    <section class="support-hero">
      <div class="container support-hero-inner">
        {/* Coordinated two-row heading: kicker with only "About" as a link, then
            the main heading. Keep the expressions adjacent — the spacing around
            the link is deliberate (no whitespace before the "?"). */}
        <h1 class="support-hero-heading">
          <span class="support-hero-heading-kicker">{s.hero.headingKicker.before}<a class="support-hero-heading-link" href={s.hero.headingKicker.linkHref}>{s.hero.headingKicker.linkLabel}</a>{s.hero.headingKicker.after}</span>
          <span class="support-hero-heading-main">{s.hero.heading}</span>
        </h1>
        <div class="support-hero-copy">
          {s.hero.paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
          <p class="support-goal">
            <span class="support-goal-amount">{s.hero.goalAmount}</span>
            <span class="support-goal-label">{s.hero.goalLabel}</span>
          </p>
          <div class="support-platforms support-hero-platforms">
            {
              platformActions.map((platform) => (
                <a
                  class="support-platform"
                  href={platform.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-support-platform={platform.key}
                  aria-label={platform.label}
                >
                  <img
                    class="support-platform-mark"
                    src={platform.logo}
                    alt=""
                    width={platform.width}
                    height={platform.height}
                    loading="lazy"
                  />
                  <svg
                    class="support-external-icon"
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                </a>
              ))
            }
          </div>
          <p class="support-hero-secondary">
            <a href={s.hero.secondaryLinkHref}>
              {s.hero.secondaryLinkLabel} <Icon name="arrow-right" size={16} />
            </a>
          </p>
        </div>
        <figure class="support-hero-media">
          <Image
            src={s.hero.portrait.image}
            alt={s.hero.portrait.alt}
            widths={[480, 720, 960]}
            sizes="(min-width: 56em) 38vw, 92vw"
            loading="eager"
            fetchpriority="high"
            style="object-position: 50% 25%"
          />
          <figcaption>{s.hero.portrait.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ── 2. Owner video — directly beneath the hero ─────────────────────── -->
    {
      /* Owner video: business.fundraising.founderVideoUrl holds the approved
         SHORT WEBSITE INTRODUCTION only. When configured, this section switches
         from the designed "Coming Soon" frame (no image, no play control) to a
         privacy-enhanced click-to-load embed (youtube-nocookie), loaded only
         when the visitor presses play. Non-YouTube values fail closed. */
    }
    <section class="support-video-section" aria-labelledby="support-video-heading">
      <div class="container container--narrow">
        <div class="section-heading">
          <h2 id="support-video-heading">{s.founderVideo.heading}</h2>
          <p class="lead">{s.founderVideo.description}</p>
        </div>
        {
          founderVideoEmbedUrl ? (
            <button
              type="button"
              class="support-video-frame support-video-frame--playable"
              data-founder-video
              data-embed-url={founderVideoEmbedUrl}
              data-cta="support-founder-video"
              aria-label="Watch the founder video"
            >
              <span class="support-video-overlay">
                <span class="support-video-play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" focusable="false">
                    <path d="M8 5.5v13l10.5-6.5z" />
                  </svg>
                </span>
                <span class="support-video-label">Watch the video</span>
              </span>
            </button>
          ) : (
            <div class="support-video-frame support-video-frame--pending">
              <p class="support-video-pending">{s.founderVideo.pending}</p>
              <svg
                class="support-video-camera-off"
                viewBox="0 0 24 24"
                width="46"
                height="46"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M4 7h9a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2z" />
                <path d="M15 10.5 21 7.5v9l-6-3" />
                <line x1="3" y1="3" x2="21" y2="21" />
              </svg>
            </div>
          )
        }
      </div>
    </section>

    <!-- ── 3. Personal investment ─────────────────────────────────────────── -->
    <section class="section section--alt" aria-labelledby="support-investment-heading">
      <div class="container">
        <div class="section-heading">
          <h2 id="support-investment-heading">{s.investment.heading}</h2>
          <p class="support-investment-subheading">{s.investment.subheading}</p>
        </div>
        <div class="prose support-investment-copy">
          {s.investment.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="support-investment-photos">
          {
            s.investment.photos.map((photo) => (
              <figure>
                <Image
                  src={photo.image}
                  alt={photo.alt}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 48em) 46vw, 92vw"
                  loading="lazy"
                />
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── 4. Where your support would go (approved allocation) ───────────── -->
    <section class="section" id="use-of-funds" aria-labelledby="support-budget-heading">
      <div class="container">
        <div class="section-heading">
          <h2 id="support-budget-heading">{s.budget.heading}</h2>
          {s.budget.paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
        </div>
        <div class="support-budget">
          <p class="eyebrow support-budget-label">{s.budget.allocationLabel}</p>
          <ul class="support-alloc">
            {
              s.budget.items.map((item) => {
                const share = shareOf(item.amount);
                return (
                  <li>
                    <div class="support-alloc-head">
                      <h3>{item.label}</h3>
                      <span class="support-alloc-amount">
                        {fmt(item.amount)} · {fmtShare(share)}
                      </span>
                    </div>
                    <div class="support-alloc-bar" aria-hidden="true">
                      <span style={`width: ${share}%`} />
                    </div>
                  </li>
                );
              })
            }
            <li class="support-alloc-total">
              <span>{s.budget.totalLabel}</span>
              <span>{fmt(total)} · 100%</span>
            </li>
          </ul>
          <div class="support-priorities">
            {
              s.budget.priorities.map((priority) => (
                <div class="support-priority">
                  <h3>{priority.title}</h3>
                  <p>{priority.text}</p>
                </div>
              ))
            }
          </div>
          <p class="support-priority-remaining">{s.budget.remainingNote}</p>
          <p class="support-priority-note">{s.budget.outcomesNote}</p>
          <p class="support-disclosure">{s.budget.disclosure}</p>
        </div>
      </div>
    </section>

    <!-- ── 5. Other ways to help ──────────────────────────────────────────── -->
    <section
      class="section section--alt support-other-ways"
      id="other-ways-to-help"
      aria-labelledby="support-other-ways-heading"
    >
      <div class="container">
        <div class="section-heading">
          <h2 id="support-other-ways-heading">{s.otherWays.heading}</h2>
          <p class="lead">{s.otherWays.lead}</p>
        </div>
        <ul class="support-help-options">
          {
            s.otherWays.items.map((item) => (
              <li class="support-help-card">
                <span class="support-help-icon">
                  <Icon name={item.icon} />
                </span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <div class="cluster support-help-actions">
                  {item.actions.map((action) =>
                    action.behavior === 'reviews' ? (
                      <a
                        class="support-help-action"
                        href={business.reviewsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {action.label} <Icon name="arrow-right" size={15} />
                      </a>
                    ) : action.behavior === 'copy' ? (
                      <button type="button" class="support-help-action" data-copy-support>
                        {action.label} <Icon name="arrow-right" size={15} />
                      </button>
                    ) : action.behavior === 'share' ? (
                      <button type="button" class="support-help-action" data-share-support>
                        {action.label} <Icon name="arrow-right" size={15} />
                      </button>
                    ) : (
                      <a class="support-help-action" href={action.href}>
                        {action.label} <Icon name="arrow-right" size={15} />
                      </a>
                    ),
                  )}
                </div>
              </li>
            ))
          }
        </ul>
        <p class="support-share-status" data-share-status role="status" aria-live="polite"></p>
        <div class="support-platforms support-ways-repeat">
          {
            platformActions.map((platform) => (
              <a
                class="support-platform"
                href={platform.href}
                target="_blank"
                rel="noopener noreferrer"
                data-support-platform={platform.key}
                aria-label={platform.label}
              >
                <img
                  class="support-platform-mark"
                  src={platform.logo}
                  alt=""
                  width={platform.width}
                  height={platform.height}
                  loading="lazy"
                />
                <svg
                  class="support-external-icon"
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── 6. Short FAQ ───────────────────────────────────────────────────── -->
    <section class="section" aria-labelledby="support-faq-heading">
      <div class="container container--narrow">
        <div class="section-heading">
          <h2 id="support-faq-heading">Transparency FAQ</h2>
        </div>
        <div class="faq-list">
          {
            s.faqs.map((faq) => (
              <FaqItem question={faq.question}>
                <p>{faq.answer}</p>
              </FaqItem>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <!-- Share / copy: native Web Share API with clipboard fallbacks. No SDKs, no
       trackers, no personal data; the canonical clean URL is shared or copied. -->
  <script is:inline>
    (function () {
      var statusNodes = document.querySelectorAll('[data-share-status]');
      function announce(message) {
        for (var i = 0; i < statusNodes.length; i++) statusNodes[i].textContent = message;
      }
      function canonicalUrl() {
        var canonical = document.querySelector('link[rel="canonical"]');
        return canonical ? canonical.href : window.location.href;
      }
      function copyUrl() {
        var url = canonicalUrl();
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(
            function () {
              announce('Campaign link copied to your clipboard.');
            },
            function () {
              announce('Copy this link: ' + url);
            },
          );
          return;
        }
        announce('Copy this link: ' + url);
      }
      document.addEventListener('click', function (event) {
        if (event.target.closest('[data-copy-support]')) {
          copyUrl();
          return;
        }
        var button = event.target.closest('[data-share-support]');
        if (!button) return;
        var url = canonicalUrl();
        var shareData = {
          title: document.title,
          text: 'Sunshine Climate Solutions is already operating — this campaign funds its next stage of growth.',
          url: url,
        };
        if (navigator.share) {
          navigator.share(shareData).then(
            function () {
              announce('Thanks for sharing this campaign.');
            },
            function () {
              /* share cancelled — no message */
            },
          );
          return;
        }
        copyUrl();
      });
    })();
  </script>

  <!-- Founder video: swap the frame for the privacy-enhanced YouTube embed only
       when the visitor presses play — no third-party request before that, and
       only ever a youtube-nocookie embed URL rendered by the build. The script
       is emitted only when a valid video URL is configured. -->
  {
    founderVideoEmbedUrl && (
      <script is:inline>
        (function () {
          var button = document.querySelector('[data-founder-video]');
          if (!button) return;
          button.addEventListener('click', function () {
            var embedUrl = button.getAttribute('data-embed-url') || '';
            if (embedUrl.indexOf('https://www.youtube-nocookie.com/embed/') !== 0) return;
            var frame = document.createElement('div');
            frame.className = 'support-video-frame support-video-frame--embed';
            var iframe = document.createElement('iframe');
            iframe.className = 'support-video-embed';
            iframe.src = embedUrl + '?autoplay=1&rel=0';
            iframe.title = 'Sunshine Climate Solutions founder video';
            iframe.setAttribute(
              'allow',
              'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share',
            );
            iframe.setAttribute('allowfullscreen', '');
            iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
            frame.appendChild(iframe);
            button.replaceWith(frame);
            iframe.focus();
          });
        })();
      </script>
    )
  }
</BaseLayout>
