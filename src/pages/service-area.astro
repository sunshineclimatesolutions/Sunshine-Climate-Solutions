---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { business } from '../config/business';
import { need } from '../lib/site-content';

const area = await getEntry('site', 'service-area');
if (!area) throw new Error('[content] src/content/site/service-area.md is missing');

const hero = need(area.data.hero, 'service-area.md → hero');
const counties = need(area.data.counties, 'service-area.md → counties');
const beyond = need(area.data.beyond, 'service-area.md → beyond');
const coverage = need(area.data.coverage, 'service-area.md → coverage');
const ctaBand = need(area.data.ctaBand, 'service-area.md → ctaBand');

const title = area.data.metaTitle;
const description = area.data.metaDescription;
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container page-hero-inner page-hero-inner--center">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.heading}</h1>
      <p class="lead">
        {hero.lead}
      </p>
    </div>
  </section>

  <!-- Counties 2×2 beside the labeled map (September 2026 aesthetic overhaul). -->
  <section class="section" aria-labelledby="area-counties-heading">
    <div class="container">
      <div class="area-duo">
        <div>
          <div class="section-heading" style="margin-bottom: var(--sp-sm);">
            <p class="eyebrow">{counties.eyebrow}</p>
            <h2 id="area-counties-heading">{counties.heading}</h2>
          </div>
          <div class="area-list area-list--two county-list">
            {
              counties.list.map((county) => (
                <div class="county-row area-card">
                  <h3>
                    <Icon name="map-pin" /> {county.name}
                  </h3>
                  <ul>
                    {county.communities.map((community) => (
                      <li>{community}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          {counties.hubNote && (
            <p class="muted" style="margin-top: var(--sp-sm); font-size: var(--text-sm);">
              {counties.hubNote}{' '}
              <a class="text-link" href="/service-area/spring-hill-fl/">
                {counties.hubLinkLabel} <Icon name="arrow-right" size={18} />
              </a>
            </p>
          )}
        </div>
        <figure class="service-map-full">
          <img
            src="/images/service-area-map.svg"
            alt="Map of west-central Florida showing Hernando, Pasco, Pinellas and Hillsborough counties highlighted and labeled, with neighboring counties and the Gulf of America for context."
            loading="lazy"
            width="1674"
            height="2219"
          />
          <figcaption>
            Serving Hernando, Pasco, Pinellas and Hillsborough counties.{' '}
            <span class="map-source">County boundaries: U.S. Census Bureau.</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Beyond Tampa Bay + coverage check as matched-height panels. -->
  <section class="section section--alt" aria-labelledby="area-beyond-heading">
    <div class="container home-duo">
      <div class="panel">
        <h2 id="area-beyond-heading">{beyond.strong}</h2>
        <p>
          {business.serviceArea.centralFloridaNote} {beyond.suffix}
        </p>
        <div class="cluster" style="margin-top: var(--sp-2xs);">
          <a class="btn btn--navy" href={business.phone.href} data-cta="call-area-beyond">
            <Icon name="phone" onDark /> Call {business.phone.display}
          </a>
        </div>
      </div>
      <div class="panel">
        <p class="eyebrow">{coverage.eyebrow}</p>
        <h2 id="area-check-heading">{coverage.heading}</h2>
        <p>
          {coverage.lead}
        </p>
        <div class="cluster" style="margin-top: var(--sp-2xs);">
          <a class="btn btn--navy" href={business.phone.href} data-cta="call-area">
            <Icon name="phone" onDark /> Call {business.phone.display}
          </a>
          <a class="btn btn--outline-navy" href={business.phone.sms} data-cta="text-area">
            <Icon name="message" /> Text your address
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand context="area" title={ctaBand.title} text={ctaBand.text} />
</BaseLayout>
