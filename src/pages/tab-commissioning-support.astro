---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TrustChips from '../components/TrustChips.astro';
import CtaBand from '../components/CtaBand.astro';
import { business } from '../config/business';
import { need } from '../lib/site-content';
import PhotoCard from '../components/PhotoCard.astro';

const tab = await getEntry('site', 'tab');
if (!tab) throw new Error('[content] src/content/site/tab.md is missing');

const hero = need(tab.data.hero, 'tab.md → hero');
const heroCtaLabel = need(hero.ctaLabel, 'tab.md → hero.ctaLabel');
const servicesCopy = need(tab.data.services, 'tab.md → services');
const callout = need(tab.data.callout, 'tab.md → callout');
const processCopy = need(tab.data.process, 'tab.md → process');
const ctaBand = need(tab.data.ctaBand, 'tab.md → ctaBand');
const visuals = tab.data.visuals; // optional until photos approved

const title = tab.data.metaTitle;
const description = tab.data.metaDescription;
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.heading}</h1>
      <p class="lead">
        {hero.lead}
      </p>
      <div class="cluster" style="margin-top: var(--sp-xs);">
        <a
          class="btn btn--navy btn--lg"
          href="/contact/?service=tab-commissioning-support"
          data-cta="request-tab-page"
        >
          <Icon name="clipboard" /> {heroCtaLabel}
        </a>
        <a class="btn btn--outline-navy" href={business.phone.href} data-cta="call-tab-page">
          <Icon name="phone" /> Call {business.phone.display}
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tab-services-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{servicesCopy.eyebrow}</p>
        <h2 id="tab-services-heading">{servicesCopy.heading}</h2>
      </div>
      <div class="grid--seven">
        {
          servicesCopy.cards.map((item) => (
            <div class="card">
              <span class="card-icon">
                <Icon name={item.icon} />
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))
        }
      </div>

      <div class="callout" style="margin-top: var(--sp-xl);">
        <strong>{callout.strong}</strong>
        <span>
          {callout.text}
        </span>
      </div>

      {visuals && visuals.photos.length > 0 && (
        <div class="stack" style="margin-top: var(--sp-xl);">
          <div class="section-heading">
            <p class="eyebrow">{visuals.eyebrow}</p>
            <h2>{visuals.heading}</h2>
            <p class="lead">
              {visuals.lead}
            </p>
          </div>
          <div class="tab-visuals">
            {visuals.photos.map((photo) => (
              <PhotoCard
                image={photo.image}
                alt={photo.alt}
                title={photo.caption}
                caption=""
                position={photo.position}
              />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="tab-process-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{processCopy.eyebrow}</p>
        <h2 id="tab-process-heading">{processCopy.heading}</h2>
      </div>
      <div class="steps">
        {
          processCopy.steps.map((step, index) => (
            <div class="step">
              <span class="step-num" aria-hidden="true">{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          ))
        }
      </div>

      <div style="margin-top: var(--sp-lg);">
        <TrustChips />
      </div>
    </div>
  </section>

  <CtaBand
    context="tab"
    title={ctaBand.title}
    text={ctaBand.text}
    requestLabel={ctaBand.requestLabel}
    requestHref="/contact/?service=tab-commissioning-support"
  />
</BaseLayout>
