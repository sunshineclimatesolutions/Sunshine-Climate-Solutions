---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import TrustChips from '../components/TrustChips.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Steps from '../components/Steps.astro';
import { business } from '../config/business';
import { need } from '../lib/site-content';

const contact = await getEntry('site', 'contact');
if (!contact) throw new Error('[content] src/content/site/contact.md is missing');

const hero = need(contact.data.hero, 'contact.md → hero');
const waysHeading = need(contact.data.waysHeading, 'contact.md → waysHeading');
const processCopy = need(contact.data.process, 'contact.md → process');

const title = contact.data.metaTitle;
const description = contact.data.metaDescription;
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container page-hero-inner page-hero-inner--center">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.heading}</h1>
      <div class="cluster" style="margin-top: var(--sp-xs); justify-content: center;">
        <a class="btn btn--gold btn--lg" href={business.phone.href} data-cta="call-contact-hero">
          <Icon name="phone" /> Call {business.phone.display}
        </a>
        <a class="btn btn--outline-navy btn--lg" href={business.phone.sms} data-cta="text-contact-hero">
          <Icon name="message" /> Text Us
        </a>
        <a
          class="hero-alt"
          href={`mailto:${business.email}`}
          data-cta="email-contact-hero"
        >
          <Icon name="mail" /> {business.email}
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="request-heading">
    <div class="container home-duo">
      <div class="stack stack--lg contact-info">
        <h2 id="request-heading" style="font-size: var(--text-h2);">{waysHeading}</h2>
        <div class="card contact-reach">
          <p class="contact-reach-line">
            <span class="card-icon"><Icon name="phone" /></span>
            <a href={business.phone.href} data-cta="call-contact-card" class="text-link">
              {business.phone.display}
            </a>
          </p>
          <p class="contact-reach-line">
            <span class="card-icon"><Icon name="message" /></span>
            <a href={business.phone.sms} data-cta="text-contact-card" class="text-link">
              Text the same number
            </a>
          </p>
          <p class="contact-reach-line">
            <span class="card-icon"><Icon name="mail" /></span>
            <a href={`mailto:${business.email}`} data-cta="email-contact-card" class="text-link">
              {business.email}
            </a>
          </p>
          <p class="contact-reach-hours">{business.hours.display} EST, 7 Days a Week</p>
        </div>

        <p class="muted">
          Serving Hernando, Pasco, Pinellas, and Hillsborough counties — Tampa Bay and
          surrounding communities. Central Florida projects are considered depending on scope.
        </p>

        {business.licenseNumber && (
          <p class="license-line">
            <Icon name="badge" /> Licensed and insured · {business.licenseNumber}
          </p>
        )}

        <TrustChips />

        <div>
          <h2 style="font-size: var(--text-h3);">Follow us</h2>
          <SocialLinks />
        </div>
      </div>

      <div class="form-card" id="request-form">
        <h2 style="font-size: var(--text-h2); margin-bottom: var(--sp-md);">Request service</h2>
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{processCopy.eyebrow}</p>
        <h2 id="process-heading">{processCopy.heading}</h2>
      </div>
      <Steps />
    </div>
  </section>
</BaseLayout>
