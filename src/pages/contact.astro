---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import TrustChips from '../components/TrustChips.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Steps from '../components/Steps.astro';
import { business } from '../config/business';
import { need } from '../lib/site-content';

const contact = await getEntry('site', 'contact');
if (!contact) throw new Error('[content] src/content/site/contact.md is missing');

const hero = need(contact.data.hero, 'contact.md → hero');
const waysHeading = need(contact.data.waysHeading, 'contact.md → waysHeading');
const processCopy = need(contact.data.process, 'contact.md → process');

const title = contact.data.metaTitle;
const description = contact.data.metaDescription;
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container page-hero-inner page-hero-inner--center">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.heading}</h1>
      {hero.lead && <p class="lead">{hero.lead}</p>}
    </div>
  </section>

  <section class="section contact-request" aria-labelledby="request-heading">
    <div class="container contact-layout">
      <div class="form-card" id="request-form">
        <h2 id="request-heading" class="contact-form-heading">Tell us what's going on</h2>
        <ContactForm />
      </div>

      <aside class="contact-support" aria-labelledby="contact-support-heading">
        <h2 id="contact-support-heading" class="contact-support-heading">{waysHeading}</h2>
        <div class="contact-reach">
          <p class="contact-reach-line">
            <span class="card-icon"><Icon name="phone" /></span>
            <a href={business.phone.href} data-cta="call-contact-card" class="text-link">
              {business.phone.display}
            </a>
          </p>
          <p class="contact-reach-line">
            <span class="card-icon"><Icon name="message" /></span>
            <a href={business.phone.sms} data-cta="text-contact-card" class="text-link">
              Text us at the same number
            </a>
          </p>
          <p class="contact-reach-line">
            <span class="card-icon"><Icon name="mail" /></span>
            <a href={`mailto:${business.email}`} data-cta="email-contact-card" class="text-link">
              {business.email}
            </a>
          </p>
          <p class="contact-reach-hours">{business.hours.display} EST, 7 Days a Week</p>
        </div>

        <TrustChips />

        <p class="contact-support-area">
          Serving Hernando, Pasco, Pinellas, and Hillsborough counties. Central Florida projects
          are considered by scope.
        </p>

        {business.licenseNumber && (
          <p class="license-line">
            <Icon name="badge" /> Licensed and insured · {business.licenseNumber}
          </p>
        )}

        <div class="contact-support-follow">
          <p class="follow-label">Follow us</p>
          <SocialLinks />
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{processCopy.eyebrow}</p>
        <h2 id="process-heading">{processCopy.heading}</h2>
      </div>
      <Steps />
    </div>
  </section>
</BaseLayout>
