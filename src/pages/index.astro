---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustChips from '../components/TrustChips.astro';
import Steps from '../components/Steps.astro';
import ImageCarousel from '../components/ImageCarousel.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { business } from '../config/business';
import { need, interpolateBusiness } from '../lib/site-content';

const home = await getEntry('site', 'home');
if (!home) throw new Error('[content] src/content/site/home.md is missing');

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const projects = await getCollection('projects');
const reviews = await getCollection('reviews');

const hero = need(home.data.hero, 'home.md → hero');
const headlineAccent = need(hero.headlineAccent, 'home.md → hero.headlineAccent');
const headlineTail = need(hero.headlineTail, 'home.md → hero.headlineTail');
const pricingCopy = need(home.data.pricing, 'home.md → pricing');
const servicesCopy = need(home.data.services, 'home.md → services');
const servicesLead = servicesCopy.lead;
const tabCard = need(servicesCopy.tabCard, 'home.md → services.tabCard');
const diagnostics = need(home.data.diagnostics, 'home.md → diagnostics');
const tabBand = need(home.data.tabBand, 'home.md → tabBand');
const workmanship = need(home.data.workmanship, 'home.md → workmanship');
const areaCopy = need(home.data.serviceArea, 'home.md → serviceArea');
const reviewsCopy = need(home.data.reviews, 'home.md → reviews');
const processCopy = need(home.data.process, 'home.md → process');
const finalCopy = need(home.data.final, 'home.md → final');
const brands = home.data.brands; // optional equipment-brands strip

// Custom multi-color icons (September 2026 design change order).
const serviceIcons: Record<string, string> = {
  'ac-repair-diagnostics': 'wrench-silver',
  'replacement-installation': 'ac-fan',
  'ac-maintenance': 'sparkles-blue',
  'airflow-ductwork': 'airflow-blue',
  'commercial-service-maintenance': 'briefcase-black',
};

const title = home.data.metaTitle;
const description = home.data.metaDescription;
---

<BaseLayout title={title} description={description}>
  <!-- Hero: split editorial — headline and actions beside one large field photograph. -->
  <section class="hero">
    <div class="container hero-split">
      <div class="hero-copy">
        <h1>
          {hero.headline} <span class="accent">{headlineAccent}</span>
          {headlineTail && ` ${headlineTail}`}
        </h1>
        <p class="lead">
          {hero.lead}
        </p>
        <div class="hero-actions">
          <a class="btn btn--gold btn--lg" href="/contact/" data-cta="request-hero">
            <Icon name="clipboard" /> Request Service
          </a>
          <a class="btn btn--outline-navy btn--lg" href={business.phone.href} data-cta="call-hero">
            <Icon name="phone" /> Call {business.phone.display}
          </a>
          <a class="hero-alt" href={business.phone.sms} data-cta="text-hero">
            <Icon name="message" /> Text Us
          </a>
        </div>
        <TrustChips variant="line" />
      </div>
      {
        hero.image && (
          <figure class="hero-media">
            <Image
              src={hero.image}
              alt={hero.imageAlt ?? ''}
              widths={[560, 840, 1200]}
              sizes="(min-width: 64em) 42vw, 92vw"
              loading="eager"
              fetchpriority="high"
              style={hero.imagePosition ? `object-position: ${hero.imagePosition}` : undefined}
            />
          </figure>
        )
      }
    </div>
  </section>

  <!-- Pricing: a rate sheet, not three floating cards. -->
  <section class="rates" aria-labelledby="home-pricing-heading">
    <div class="container">
      <div class="section-head">
        <p class="kicker">Pricing</p>
        <h2 id="home-pricing-heading">{pricingCopy.heading}</h2>
      </div>
      <div class="rate-sheet">
        {
          pricingCopy.items.map((item, index) => {
            const featured = index === 1;
            return (
              <article class={`rate${featured ? ' rate--featured on-dark' : ''}`}>
                <p class="rate-price">{item.price}</p>
                <h3>{item.title}</h3>
                <p class="rate-text">{interpolateBusiness(item.text)}</p>
                {item.linkLabel && item.linkHref && (
                  <div class="rate-actions">
                    <a
                      class={`btn ${featured ? 'btn--gold' : 'btn--outline-navy'}`}
                      href={item.linkHref}
                      data-cta={`pricing-${index}`}
                    >
                      {featured && <Icon name="clipboard" />} {item.linkLabel}
                    </a>
                    {featured && (
                      <a class="hero-alt" href={business.phone.href} data-cta="call-pricing">
                        <Icon name="phone" onDark /> Call {business.phone.display}
                      </a>
                    )}
                  </div>
                )}
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Workmanship: editorial case rows with large working photographs. -->
  <section class="section" aria-labelledby="home-workmanship-heading">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="kicker">{workmanship.eyebrow}</p>
          <h2 id="home-workmanship-heading">{workmanship.heading}</h2>
        </div>
        <p class="lead">{workmanship.lead}</p>
      </div>
    </div>
    <div class="container cases">
      {
        workmanship.cards.map((card, index) => (
          <article class={`case${index % 2 === 1 ? ' case--reverse' : ''}`}>
            <div class="case-media">
              <ImageCarousel images={card.images} label={`${card.title} photos`} />
            </div>
            <div class="case-body">
              <p class="case-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="case-title">
                <a href={card.linkHref}>{card.title}</a>
              </h3>
              {card.text && <p>{card.text}</p>}
              <a class="case-link" href={card.linkHref}>
                Explore this service <Icon name="arrow-right" size={18} />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Services: one primary service, quieter supporting services. -->
  <section class="services-stage" aria-labelledby="home-services-heading">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="kicker">{servicesCopy.eyebrow}</p>
          <h2 id="home-services-heading">{servicesCopy.heading}</h2>
        </div>
        {
          servicesLead && (
            <p class="lead">
              {servicesLead}
            </p>
          )
        }
      </div>

      <div class="grid--six services-grid">
        {
          services.map((service, index) => (
            <ServiceCard
              href={`/services/${service.id}/`}
              title={service.data.title}
              serviceIcon={serviceIcons[service.id]}
              summary={service.data.summary}
              feature={index === 0}
              center
            />
          ))
        }
        <a class="card card-hover card--center svc-tile svc-tile--tab" href="/tab-commissioning-support/">
          <span class="card-icon card-icon--custom">
            <ServiceIcon name="checklist" />
          </span>
          <h3>Testing, Adjusting &amp; Balancing</h3>
          <p>{tabCard.text}</p>
          <span class="card-cta">
            {tabCard.ctaLabel} <Icon name="arrow-right" size={18} />
          </span>
        </a>
      </div>
      {servicesCopy.servingNote && <p class="service-definition">{servicesCopy.servingNote}</p>}
    </div>
  </section>

  <!-- Technical authority: field notes, measurements, evidence. -->
  <section class="fieldnotes" aria-labelledby="home-diag-heading">
    <div class="container">
      <div class="fieldnotes-top">
        <div class="fieldnotes-copy">
          <p class="kicker">{diagnostics.eyebrow}</p>
          <h2 id="home-diag-heading">{diagnostics.heading}</h2>
          <p class="lead">
            {diagnostics.lead}
          </p>
        </div>
        {
          diagnostics.image && (
            <figure class="fieldnotes-evidence">
              <Image
                src={diagnostics.image}
                alt={diagnostics.imageAlt ?? ''}
                widths={[480, 720, 960]}
                sizes="(min-width: 64em) 34vw, 92vw"
                loading="lazy"
              />
              {diagnostics.imageCaption && <figcaption>{diagnostics.imageCaption}</figcaption>}
            </figure>
          )
        }
      </div>

      <p class="fieldnotes-statement">Data-Driven Recommendations</p>

      <div class="grid--four fieldnotes-grid">
        {
          diagnostics.cards.map((card, index) => (
            <div class="fieldnote">
              <p class="fieldnote-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </p>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
          ))
        }
      </div>
      {
        diagnostics.footnote && (
          <p class="fieldnotes-footnote">
            {diagnostics.footnote.lead}{' '}
            <a href="/about/">{diagnostics.footnote.linkLabel}</a>.
          </p>
        )
      }
    </div>
  </section>

  <!-- TAB: full-width navy signature moment. -->
  <section class="tabstage on-dark" aria-labelledby="home-tab-heading">
    <div class="container tabstage-inner">
      <div class="tabstage-copy">
        <p class="kicker">{tabBand.eyebrow}</p>
        <h2 id="home-tab-heading">{tabBand.heading}</h2>
        <p class="tabstage-text">
          {tabBand.text}
        </p>
        {tabBand.note && <p class="tabstage-note">{tabBand.note}</p>}
        <div class="cluster tabstage-actions">
          <a
            class="btn btn--gold btn--lg"
            href="/contact/?service=tab-commissioning-support"
            data-cta="request-tab-proposal"
          >
            <Icon name="clipboard" /> {tabBand.ctaLabel}
          </a>
          <a
            class="btn btn--outline-light"
            href="/tab-commissioning-support/"
            data-cta="tab-learn-more"
          >
            {tabBand.secondaryLabel}
          </a>
        </div>
      </div>
      {
        tabBand.image && (
          <figure class="tabstage-media">
            <Image
              src={tabBand.image}
              alt={tabBand.imageAlt ?? ''}
              widths={[520, 780, 1040]}
              sizes="(min-width: 64em) 40vw, 92vw"
              loading="lazy"
              style="object-position: 45% 55%"
            />
          </figure>
        )
      }
    </div>
  </section>

  <!-- Service area: geography as brand. -->
  <section class="area-band" aria-labelledby="home-area-heading">
    <div class="container">
      <div class="section-head">
        <p class="kicker">{areaCopy.eyebrow}</p>
        <h2 id="home-area-heading">{areaCopy.heading}</h2>
      </div>

      <div class="area-duo">
        <div class="area-counties">
          <div class="area-list area-list--two county-list">
            {
              business.serviceArea.countyDetails.map((county) => (
                <div class="county-row area-card">
                  <h3>
                    <Icon name="map-pin" /> {county.name}
                  </h3>
                  <ul>
                    {county.cities.map((city) => (
                      <li>{city}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          <p class="area-note">
            {business.serviceArea.centralFloridaNote}
          </p>
          <p class="cluster area-links">
            <a class="text-link" href="/service-area/">
              {areaCopy.linkLabel} <Icon name="arrow-right" size={18} />
            </a>
            {areaCopy.hubLinkLabel && (
              <a class="text-link" href="/service-area/spring-hill-fl/">
                {areaCopy.hubLinkLabel} <Icon name="arrow-right" size={18} />
              </a>
            )}
          </p>
        </div>
        <figure class="service-map-full">
          <img
            src="/images/service-area-map.svg"
            alt="Map of west-central Florida showing Hernando, Pasco, Pinellas and Hillsborough counties highlighted and labeled, with neighboring counties and the Gulf of America for context."
            loading="lazy"
            width="1674"
            height="2219"
          />
          <figcaption>Serving Hillsborough, Pinellas, Hernando and Pasco counties.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Reviews: honest provenance + direct Google access while the review
       collection is intentionally empty. -->
  <section class="reviews-band" aria-labelledby="home-reviews-heading">
    <div class="container">
      <div class="reviews-split">
        <div class="reviews-copy">
          <p class="kicker">Reviews</p>
          <h2 id="home-reviews-heading">{reviewsCopy.heading}</h2>
          {reviewsCopy.note && <p class="lead">{reviewsCopy.note}</p>}
        </div>
        <div class="reviews-access">
          <a
            class="btn btn--navy btn--lg"
            href={business.reviewsUrl}
            data-cta="reviews-google-home"
            rel="noopener"
          >
            <img class="google-g" src="/brand/google-g.svg" alt="" width="26" height="26" />
            See Our Google Reviews
          </a>
        </div>
      </div>
      {
        reviews.length > 0 && (
          <div class={`grid reviews-grid${reviews.length < 3 ? ' reviews-grid--pair' : ''}`}>
            {reviews
              .sort((a, b) => a.data.order - b.data.order)
              .slice(0, 3)
              .map((review) => (
                <blockquote class="card">
                  <p>“{review.data.quote}”</p>
                  <footer style="margin-top: auto; font-size: var(--text-sm); color: var(--c-ink-soft);">
                    — {review.data.author}
                    {review.data.source === 'google' && (
                      <>
                        {' · '}
                        <a class="text-link" href={business.reviewsUrl} rel="noopener">
                          Google Reviews →
                        </a>
                      </>
                    )}
                    {review.data.context ? `, ${review.data.context}` : ''}
                  </footer>
                </blockquote>
              ))}
          </div>
        )
      }
      {reviewsCopy.followLabel && (
        <div class="follow-row">
          <p class="follow-label">{reviewsCopy.followLabel}</p>
          <SocialLinks />
        </div>
      )}
      {projects.length > 0 && (
        <p class="reviews-work-link">
          <a class="text-link" href="/our-work/">
            {reviewsCopy.workLink} <Icon name="arrow-right" size={18} />
          </a>
        </p>
      )}
    </div>
  </section>

  <!-- Process: a timeline, not four cards. -->
  <section class="section process-band" aria-labelledby="home-process-heading">
    <div class="container">
      <div class="section-head">
        <p class="kicker">{processCopy.eyebrow}</p>
        <h2 id="home-process-heading">{processCopy.heading}</h2>
      </div>
      <Steps />
    </div>
  </section>

  <!-- Final CTA: a deliberate closing moment. -->
  <section class="finale on-dark" aria-labelledby="home-contact-heading">
    <div class="container finale-inner">
      <h2 id="home-contact-heading">{finalCopy.heading}</h2>
      <p class="lead">
        {finalCopy.lead}
      </p>
      <div class="cluster finale-actions">
        <a class="btn btn--gold btn--lg" href="/contact/" data-cta="request-final">
          <Icon name="clipboard" /> Request Service
        </a>
        <a class="btn btn--outline-light btn--lg" href={business.phone.href} data-cta="call-final">
          <Icon name="phone" onDark /> Call {business.phone.display}
        </a>
      </div>
      <TrustChips variant="line" onDark />
    </div>
  </section>

  <!-- Brands: a quiet, hairline-framed credibility footer to the story. -->
  {
    brands && (
      <section class="brands-band" aria-labelledby="brands-heading">
        <div class="container">
          <div class="section-head section-head--center">
            <h2 id="brands-heading">{brands.heading}</h2>
            {brands.lead && <p class="brands-lead">{brands.lead}</p>}
          </div>
          <ul class="brand-list brand-grid">
            <li class="brand-box"><img src="/images/brand-carrier.png" alt="Carrier" loading="lazy" width="348" height="150" /></li>
            <li class="brand-box"><img src="/images/brand-goodman.png" alt="Goodman" loading="lazy" width="322" height="135" /></li>
            <li class="brand-box"><img src="/images/brand-lennox.png" alt="Lennox" loading="lazy" width="326" height="93" /></li>
            <li class="brand-box"><img src="/images/brand-rheem.png" alt="Rheem" loading="lazy" width="320" height="315" /></li>
            <li class="brand-box"><img src="/images/brand-ruud.png" alt="Ruud" loading="lazy" width="348" height="217" /></li>
            <li class="brand-box"><img src="/images/brand-trane.png" alt="Trane" loading="lazy" width="280" height="348" /></li>
            <li class="brand-box"><img src="/images/brand-daikin.webp" alt="Daikin" loading="lazy" width="320" height="160" /></li>
            <li class="brand-box"><img src="/images/brand-mitsubishi-electric.webp" alt="Mitsubishi Electric" loading="lazy" width="474" height="238" /></li>
            <li class="brand-box brand-box--more">
              <a href="/services/">
                &amp; More <Icon name="arrow-right" size={18} />
              </a>
            </li>
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
