---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustChips from '../components/TrustChips.astro';
import Steps from '../components/Steps.astro';
import { business, licenseDisplay } from '../config/business';
import { need } from '../lib/site-content';
import PhotoCard from '../components/PhotoCard.astro';

const home = await getEntry('site', 'home');
if (!home) throw new Error('[content] src/content/site/home.md is missing');

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const featured = services.slice(0, 2);
const rest = services.slice(2);
const projects = await getCollection('projects');
const reviews = await getCollection('reviews');
const license = licenseDisplay();

const hero = need(home.data.hero, 'home.md → hero');
const headlineAccent = need(hero.headlineAccent, 'home.md → hero.headlineAccent');
const headlineTail = need(hero.headlineTail, 'home.md → hero.headlineTail');
const servicesCopy = need(home.data.services, 'home.md → services');
const servicesLead = need(servicesCopy.lead, 'home.md → services.lead');
const tabCard = need(servicesCopy.tabCard, 'home.md → services.tabCard');
const diagnostics = need(home.data.diagnostics, 'home.md → diagnostics');
const tabBand = need(home.data.tabBand, 'home.md → tabBand');
const offerBand = need(home.data.offerBand, 'home.md → offerBand');
const aboutBand = need(home.data.aboutBand, 'home.md → aboutBand');
const areaCopy = need(home.data.serviceArea, 'home.md → serviceArea');
const reviewsCopy = need(home.data.reviews, 'home.md → reviews');
const processCopy = need(home.data.process, 'home.md → process');
const finalCopy = need(home.data.final, 'home.md → final');
const proof = home.data.proof; // optional until photos are approved
const brands = home.data.brands; // optional equipment-brands strip

const title = home.data.metaTitle;
const description = home.data.metaDescription;
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="hero on-dark">
    <div class="hero-deco" aria-hidden="true">
      <svg viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="200" cy="200" r="150"></circle>
        <circle cx="200" cy="200" r="110" stroke-dasharray="4 14"></circle>
        <circle cx="200" cy="200" r="55"></circle>
        <line x1="200" y1="375" x2="200" y2="350"></line>
        <line x1="25" y1="200" x2="50" y2="200"></line>
        <line x1="375" y1="200" x2="350" y2="200"></line>
        <line x1="306" y1="94" x2="324" y2="76"></line>
        <line x1="94" y1="306" x2="76" y2="324"></line>
        <line x1="306" y1="306" x2="324" y2="324"></line>
        <line x1="94" y1="94" x2="76" y2="76"></line>
      </svg>
    </div>
    <div class="container hero-inner">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>
        {hero.headline} <span class="accent">{headlineAccent}</span> {headlineTail}
      </h1>
      <p class="lead">
        {hero.lead}
      </p>
      <div class="hero-actions">
        <a class="btn btn--gold btn--lg" href={business.phone.href} data-cta="call-hero">
          <Icon name="phone" /> Call {business.phone.display}
        </a>
        <a class="btn btn--outline-light btn--lg" href="/contact/" data-cta="request-hero">
          Request Service
        </a>
        <a class="hero-alt" href={business.phone.sms} data-cta="text-hero">
          <Icon name="message" /> Text Us
        </a>
      </div>
      <p class="offer-chip">
        <strong>{business.pricing.serviceCall} service call</strong>
        <span class="dot" aria-hidden="true">·</span>
        <span>{business.pricing.serviceCallWaiver}</span>
        <span class="dot" aria-hidden="true">·</span>
        <span>{business.pricing.estimates}</span>
      </p>
      <TrustChips />
    </div>
  </section>

  {proof && proof.cards.length > 0 && (
    <section class="section" aria-labelledby="home-proof-heading">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">{proof.eyebrow}</p>
          <h2 id="home-proof-heading">{proof.heading}</h2>
          <p class="lead">
            {proof.lead}
          </p>
        </div>
        <div class="grid photo-grid">
          {proof.cards.map((card) => (
            <PhotoCard
              image={card.image}
              alt={card.alt}
              title={card.title}
              text={card.text}
              linkLabel={card.linkLabel}
              linkHref={card.linkHref}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Services -->
  <section class="section section--alt" aria-labelledby="home-services-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{servicesCopy.eyebrow}</p>
        <h2 id="home-services-heading">{servicesCopy.heading}</h2>
        <p class="lead">
          {servicesLead}
        </p>
      </div>

      <div class="grid grid--wide">
        {
          featured.map((service) => (
            <ServiceCard
              href={`/services/${service.id}/`}
              title={service.data.title}
              icon={service.data.icon}
              summary={service.data.summary}
            />
          ))
        }
      </div>
      <div class="grid" style="margin-top: var(--sp-md);">
        {
          rest.map((service) => (
            <ServiceCard
              href={`/services/${service.id}/`}
              title={service.data.title}
              icon={service.data.icon}
              summary={service.data.summary}
            />
          ))
        }
        <a class="card card-hover" href="/tab-commissioning-support/" style="background: var(--c-navy); border-color: var(--c-navy);">
          <span class="card-icon"><Icon name="activity" /></span>
          <h3 style="color: #fff;">{tabCard.title}</h3>
          <p style="color: var(--c-on-navy-soft);">
            {tabCard.text}
          </p>
          <span class="card-cta" style="color: var(--c-gold);">
            {tabCard.ctaLabel} <Icon name="arrow-right" size={18} />
          </span>
        </a>
      </div>
      <p class="muted" style="margin-top: var(--sp-md); font-size: var(--text-sm);">
        {servicesCopy.footnote}
      </p>

      {brands && (
        <div class="brand-strip" aria-labelledby="brands-heading">
          <h2 id="brands-heading" class="visually-hidden">{brands.heading}</h2>
          <p class="brand-strip-heading">{brands.heading}</p>
          {brands.lead && <p class="muted brand-strip-lead">{brands.lead}</p>}
          <ul class="brand-list">
            <li class="brand-box"><img src="/images/brand-carrier.png" alt="Carrier" loading="lazy" width="360" height="162" /></li>
            <li class="brand-box"><img src="/images/brand-goodman.png" alt="Goodman" loading="lazy" width="360" height="182" /></li>
            <li class="brand-box"><img src="/images/brand-lennox.png" alt="Lennox" loading="lazy" width="360" height="128" /></li>
            <li class="brand-box"><img src="/images/brand-rheem.png" alt="Rheem" loading="lazy" width="360" height="360" /></li>
            <li class="brand-box"><img src="/images/brand-ruud.png" alt="Ruud" loading="lazy" width="360" height="229" /></li>
            <li class="brand-box"><img src="/images/brand-trane.png" alt="Trane" loading="lazy" width="292" height="360" /></li>
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- Diagnostics strengths -->
  <section class="section" aria-labelledby="home-diag-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{diagnostics.eyebrow}</p>
        <h2 id="home-diag-heading">{diagnostics.heading}</h2>
        <p class="lead">
          {diagnostics.lead}
        </p>
      </div>
      <div class="grid">
        {
          diagnostics.cards.map((card) => (
            <div class="card">
              <span class="card-icon"><Icon name={card.icon} /></span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
          ))
        }
      </div>
      {
        diagnostics.footnote && (
          <p class="muted" style="margin-top: var(--sp-md);">
            {diagnostics.footnote.lead}
            <a href="/about/">{diagnostics.footnote.linkLabel}</a>.
          </p>
        )
      }
    </div>
  </section>

  <!-- TAB / professional route -->
  <section class="cta-band on-dark" aria-labelledby="home-tab-heading">
    <div class="container cta-band-inner">
      <div>
        <p class="eyebrow">{tabBand.eyebrow}</p>
        <h2 id="home-tab-heading">{tabBand.heading}</h2>
        <p>
          {tabBand.text}
        </p>
        {
          tabBand.note && (
            <p style="margin-top: var(--sp-2xs); font-size: var(--text-sm);">
              {tabBand.note}
            </p>
          )
        }
      </div>
      <div class="cta-band-actions">
        <a
          class="btn btn--gold btn--lg"
          href="/contact/?service=tab-commissioning-support"
          data-cta="request-tab-proposal"
        >
          <Icon name="clipboard" /> {tabBand.ctaLabel}
        </a>
        <a class="btn btn--outline-light" href="/tab-commissioning-support/" data-cta="tab-learn-more">
          {tabBand.secondaryLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Offer band -->
  <section class="band--gold" aria-labelledby="home-offer-heading">
    <div class="container band-inner">
      <div>
        <h2 id="home-offer-heading">
          {business.pricing.serviceCall} service call — {business.pricing.serviceCallWaiver}.
        </h2>
        <p>
          {offerBand.text}
        </p>
      </div>
      <div class="cluster">
        <a class="btn btn--navy btn--lg" href={business.phone.href} data-cta="call-offer">
          <Icon name="phone" /> Call {business.phone.display}
        </a>
        <a class="text-link" href="/contact/" data-cta="request-offer" style="color: var(--c-navy);">
          {offerBand.linkLabel} <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- About + service area -->
  <section class="section" aria-labelledby="home-about-heading">
    <div class="container home-duo">
      <div>
        <p class="eyebrow">{aboutBand.eyebrow}</p>
        <h2 id="home-about-heading">{aboutBand.heading}</h2>
        <p class="muted" style="margin-top: var(--sp-xs);">
          {aboutBand.blurb}
        </p>
        <p style="margin-top: var(--sp-sm);">
          <a class="text-link" href="/about/">
            {aboutBand.linkLabel} <Icon name="arrow-right" size={18} />
          </a>
        </p>
      </div>
      <div>
        <p class="eyebrow">{areaCopy.eyebrow}</p>
        <h2>{areaCopy.heading}</h2>
        <ul class="area-list" style="margin-top: var(--sp-sm);">
          {
            business.serviceArea.counties.map((county) => (
              <li class="card" style="padding: 0.9rem 1.1rem; gap: 0.25rem;">
                <strong style="font-family: var(--font-head);">{county}</strong>
              </li>
            ))
          }
        </ul>
        <p class="muted" style="margin-top: var(--sp-sm); font-size: var(--text-sm);">
          {business.serviceArea.centralFloridaNote}
        </p>
        <figure class="service-map-compact">
          <img
            src="/images/service-area-map-compact.svg"
            alt="Compact map of west-central Florida highlighting the four counties Sunshine Climate Solutions serves. County names are listed alongside."
            loading="lazy"
            width="1674"
            height="2219"
          />
          <figcaption>
            Serving Hernando, Pasco, Pinellas and Hillsborough counties.
          </figcaption>
        </figure>
        <p style="margin-top: var(--sp-sm);">
          <a class="text-link" href="/service-area/">
            {areaCopy.linkLabel} <Icon name="arrow-right" size={18} />
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section section--alt" aria-labelledby="home-reviews-heading">
    <div class="container">
      <div class="section-heading" style="text-align: center; margin-inline: auto;">
        <p class="eyebrow">{reviewsCopy.eyebrow}</p>
        <h2 id="home-reviews-heading">{reviewsCopy.heading}</h2>
      </div>
      {
        reviews.length > 0 && (
          <div class="grid" style="margin-bottom: var(--sp-lg);">
            {reviews
              .sort((a, b) => a.data.order - b.data.order)
              .slice(0, 3)
              .map((review) => (
                <blockquote class="card">
                  <p>“{review.data.quote}”</p>
                  <footer style="margin-top: auto; font-size: var(--text-sm); color: var(--c-ink-soft);">
                    — {review.data.author}
                    {review.data.context ? `, ${review.data.context}` : ''}
                  </footer>
                </blockquote>
              ))}
          </div>
        )
      }
      <div class="cluster" style="justify-content: center;">
        <a
          class="btn btn--outline-navy btn--lg"
          href={business.reviewsUrl}
          data-cta="reviews-google-home"
          rel="noopener"
        >
          <Icon name="star" /> {business.reviewsLabel}
        </a>
      </div>
      {projects.length > 0 && (
        <p style="text-align: center; margin-top: var(--sp-md);">
          <a class="text-link" href="/our-work/">
            {reviewsCopy.workLink} <Icon name="arrow-right" size={18} />
          </a>
        </p>
      )}
    </div>
  </section>

  <!-- Process -->
  <section class="section" aria-labelledby="home-process-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{processCopy.eyebrow}</p>
        <h2 id="home-process-heading">{processCopy.heading}</h2>
      </div>
      <Steps />
    </div>
  </section>

  <!-- Final contact -->
  <section
    class="section on-dark"
    style="background: var(--c-navy);"
    aria-labelledby="home-contact-heading"
  >
    <div class="container" style="display: grid; gap: var(--sp-md); justify-items: start;">
      <div>
        <h2 id="home-contact-heading" style="color: #fff;">{finalCopy.heading}</h2>
        <p class="lead" style="margin-top: var(--sp-2xs);">
          {finalCopy.lead}
        </p>
      </div>
      <div class="cluster">
        <a class="btn btn--gold btn--lg" href={business.phone.href} data-cta="call-final">
          <Icon name="phone" /> Call {business.phone.display}
        </a>
        <a class="btn btn--outline-light btn--lg" href="/contact/" data-cta="request-final">
          Request Service
        </a>
        <a class="hero-alt" href={business.phone.sms} data-cta="text-final">
          <Icon name="message" /> Text Us
        </a>
      </div>
      <div class="on-dark">
        <TrustChips />
      </div>
      <p class="form-note" style="color: var(--c-on-navy-soft);">
        {business.pricing.serviceCall} service call, {business.pricing.serviceCallWaiver} · Free
        estimates {license ? `· ${license}` : ''}
      </p>
    </div>
  </section>
</BaseLayout>
