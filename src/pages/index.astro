---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustChips from '../components/TrustChips.astro';
import Steps from '../components/Steps.astro';
import ImageCarousel from '../components/ImageCarousel.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import ScsSignature from '../components/ScsSignature.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { business } from '../config/business';
import { need, interpolateBusiness } from '../lib/site-content';

const home = await getEntry('site', 'home');
if (!home) throw new Error('[content] src/content/site/home.md is missing');

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const projects = await getCollection('projects');
const reviews = await getCollection('reviews');

const hero = need(home.data.hero, 'home.md → hero');
const headlineAccent = need(hero.headlineAccent, 'home.md → hero.headlineAccent');
const headlineTail = need(hero.headlineTail, 'home.md → hero.headlineTail');
const pricingCopy = need(home.data.pricing, 'home.md → pricing');
const servicesCopy = need(home.data.services, 'home.md → services');
const servicesLead = need(servicesCopy.lead, 'home.md → services.lead');
const tabCard = need(servicesCopy.tabCard, 'home.md → services.tabCard');
const diagnostics = need(home.data.diagnostics, 'home.md → diagnostics');
const tabBand = need(home.data.tabBand, 'home.md → tabBand');
const workmanship = need(home.data.workmanship, 'home.md → workmanship');
const areaCopy = need(home.data.serviceArea, 'home.md → serviceArea');
const reviewsCopy = need(home.data.reviews, 'home.md → reviews');
const processCopy = need(home.data.process, 'home.md → process');
const finalCopy = need(home.data.final, 'home.md → final');
const brands = home.data.brands; // optional equipment-brands strip

// Custom multi-color icons (September 2026 design change order).
const serviceIcons: Record<string, string> = {
  'ac-repair-diagnostics': 'wrench-silver',
  'replacement-installation': 'ac-fan',
  'ac-maintenance': 'sparkles-blue',
  'airflow-ductwork': 'airflow-blue',
  'commercial-service-maintenance': 'briefcase-black',
};
const diagIcons: Record<string, string> = {
  wind: 'magnifier',
  activity: 'lightning',
  clipboard: 'clipboard-brown',
  badge: 'badge-red',
};

const title = home.data.metaTitle;
const description = home.data.metaDescription;
---

<BaseLayout title={title} description={description}>
  <!-- Hero: light editorial, centered; no eyebrow label, no dark slab. -->
  <section class="hero">
    <div class="container hero-inner hero-inner--center">
      <h1>
        {hero.headline} <span class="accent">{headlineAccent}</span>
        {headlineTail && ` ${headlineTail}`}
      </h1>
      <p class="lead">
        {hero.lead}
      </p>
      <div class="hero-actions">
        <a class="btn btn--gold btn--lg" href="/contact/" data-cta="request-hero">
          <Icon name="clipboard" /> Request Service
        </a>
        <a class="btn btn--navy btn--lg" href={business.phone.href} data-cta="call-hero">
          <Icon name="phone" /> Call {business.phone.display}
        </a>
        <a class="hero-alt hero-alt--bubble" href={business.phone.sms} data-cta="text-hero">
          <Icon name="message" /> Text Us
        </a>
      </div>
      <TrustChips />
    </div>
  </section>

  <!-- Pricing: three columns (maintenance / service call / estimates). -->
  <section class="section section--alt" aria-labelledby="home-pricing-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <h2 id="home-pricing-heading">{pricingCopy.heading}</h2>
      </div>
      <div class="pricing-grid">
        {
          pricingCopy.items.map((item, index) => (
            <div class={`card pricing-card${index === 1 ? ' pricing-card--featured' : ''}`}>
              <p class="pricing-price">{item.price}</p>
              <h3>{item.title}</h3>
              <p>{interpolateBusiness(item.text)}</p>
              {item.linkLabel && item.linkHref && (
                <div class="pricing-actions">
                  <a
                    class={`btn ${index === 1 ? 'btn--navy' : 'btn--outline-navy'}`}
                    href={item.linkHref}
                    data-cta={`pricing-${index}`}
                  >
                    {index === 1 && <Icon name="clipboard" />} {item.linkLabel}
                  </a>
                  {index === 1 && (
                    <a class="hero-alt" href={business.phone.href} data-cta="call-pricing">
                      <Icon name="phone" /> Call {business.phone.display}
                    </a>
                  )}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Workmanship: three linked cards, each with a small photo carousel. -->
  <section class="section" aria-labelledby="home-workmanship-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="eyebrow">{workmanship.eyebrow}</p>
        <h2 id="home-workmanship-heading">{workmanship.heading}</h2>
        <p class="lead">
          {workmanship.lead}
        </p>
      </div>
      <div class="grid work-grid">
        {
          workmanship.cards.map((card) => (
            <article class="card work-card">
              <ImageCarousel images={card.images} label={`${card.title} photos`} />
              <div class="work-card-body">
                <h3 class="work-card-title">
                  <a href={card.linkHref}>{card.title}</a>
                </h3>
                {card.text && <p>{card.text}</p>}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Services: six uniform cards, 3×2 desktop / 2 tablet / 1 mobile. -->
  <section class="section section--alt" aria-labelledby="home-services-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="eyebrow">{servicesCopy.eyebrow}</p>
        <h2 id="home-services-heading">{servicesCopy.heading}</h2>
        <p class="lead">
          {servicesLead}
        </p>
        {servicesCopy.servingNote && <p class="service-definition">{servicesCopy.servingNote}</p>}
      </div>

      <div class="grid--six">
        {
          services.map((service) => (
            <ServiceCard
              href={`/services/${service.id}/`}
              title={service.data.title}
              serviceIcon={serviceIcons[service.id]}
              summary={service.data.summary}
              center
            />
          ))
        }
        <a class="card card-hover card--center" href="/tab-commissioning-support/">
          <span class="card-icon card-icon--custom">
            <ServiceIcon name="checklist" />
          </span>
          <h3>Testing, Adjusting &amp; Balancing</h3>
          <p>{tabCard.text}</p>
          <span class="card-cta">
            {tabCard.ctaLabel} <Icon name="arrow-right" size={18} />
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Diagnostics strengths -->
  <section class="section" aria-labelledby="home-diag-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="eyebrow">{diagnostics.eyebrow}</p>
        <h2 id="home-diag-heading">{diagnostics.heading}</h2>
        <p class="lead">
          {diagnostics.lead}
        </p>
      </div>
      <div class="grid--four">
        {
          diagnostics.cards.map((card) => (
            <div class="card card--center">
              <span class="card-icon card-icon--custom">
                <ServiceIcon name={diagIcons[card.icon] as never} />
              </span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
          ))
        }
      </div>
      {
        diagnostics.footnote && (
          <p class="muted" style="margin-top: var(--sp-md); text-align: center;">
            {diagnostics.footnote.lead}{' '}
            <a href="/about/">{diagnostics.footnote.linkLabel}</a>.
          </p>
        )
      }
    </div>
  </section>

  <!-- TAB / professional band: pale slate-blue technical band, compact. -->
  <section class="band--technical band--center" aria-labelledby="home-tab-heading">
    <div class="container">
      <ScsSignature size={44} />
      <p class="eyebrow">{tabBand.eyebrow}</p>
      <h2 id="home-tab-heading">{tabBand.heading}</h2>
      <p>
        {tabBand.text}
      </p>
      {tabBand.note && <p style="font-size: var(--text-sm);">{tabBand.note}</p>}
      <div class="cluster">
        <a
          class="btn btn--navy btn--lg"
          href="/contact/?service=tab-commissioning-support"
          data-cta="request-tab-proposal"
        >
          <Icon name="clipboard" /> {tabBand.ctaLabel}
        </a>
        <a
          class="btn btn--outline-navy"
          href="/tab-commissioning-support/"
          data-cta="tab-learn-more"
        >
          {tabBand.secondaryLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Service area: county cards (with representative cities) beside the map. -->
  <section class="section" aria-labelledby="home-area-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="eyebrow">{areaCopy.eyebrow}</p>
        <h2 id="home-area-heading">{areaCopy.heading}</h2>
      </div>

      <div class="area-duo">
        <div>
          <ul class="area-list area-list--two">
            {
              business.serviceArea.countyDetails.map((county) => (
                <li class="card county-card">
                  <strong>{county.name}</strong>
                  <span class="county-cities">{county.cities.join(' · ')}</span>
                </li>
              ))
            }
          </ul>
          <p class="muted" style="margin-top: var(--sp-sm); font-size: var(--text-sm);">
            {business.serviceArea.centralFloridaNote}
          </p>
          <p class="cluster" style="margin-top: var(--sp-sm);">
            <a class="text-link" href="/service-area/">
              {areaCopy.linkLabel} <Icon name="arrow-right" size={18} />
            </a>
            {areaCopy.hubLinkLabel && (
              <a class="text-link" href="/service-area/spring-hill-fl/">
                {areaCopy.hubLinkLabel} <Icon name="arrow-right" size={18} />
              </a>
            )}
          </p>
        </div>
        <figure class="service-map-compact">
          <img
            src="/images/service-area-map-compact.svg"
            alt="Compact map of west-central Florida with Hernando, Pasco, Pinellas and Hillsborough counties highlighted and labeled, and the Gulf of America to the west."
            loading="lazy"
            width="1278"
            height="1469"
          />
          <figcaption>Serving Hillsborough, Pinellas, Hernando and Pasco counties.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Reviews: honest provenance + direct Google access while the review
       collection is intentionally empty; social follow block underneath. -->
  <section class="section section--alt" aria-labelledby="home-reviews-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <h2 id="home-reviews-heading">{reviewsCopy.heading}</h2>
        {reviewsCopy.note && <p class="lead">{reviewsCopy.note}</p>}
      </div>
      {
        reviews.length > 0 && (
          <div class="grid" style="margin-bottom: var(--sp-lg);">
            {reviews
              .sort((a, b) => a.data.order - b.data.order)
              .slice(0, 3)
              .map((review) => (
                <blockquote class="card">
                  <p>“{review.data.quote}”</p>
                  <footer style="margin-top: auto; font-size: var(--text-sm); color: var(--c-ink-soft);">
                    — {review.data.author}
                    {review.data.context ? `, ${review.data.context}` : ''}
                  </footer>
                </blockquote>
              ))}
          </div>
        )
      }
      <div class="cluster" style="justify-content: center;">
        <a
          class="btn btn--navy btn--lg"
          href={business.reviewsUrl}
          data-cta="reviews-google-home"
          rel="noopener"
        >
          <Icon name="star" /> See Our Reviews on Google
        </a>
      </div>
      {reviewsCopy.followLabel && (
        <div class="follow-block">
          <p class="follow-label">{reviewsCopy.followLabel}</p>
          <SocialLinks />
        </div>
      )}
      {projects.length > 0 && (
        <p style="text-align: center; margin-top: var(--sp-md);">
          <a class="text-link" href="/our-work/">
            {reviewsCopy.workLink} <Icon name="arrow-right" size={18} />
          </a>
        </p>
      )}
    </div>
  </section>

  <!-- Process (2×2 steps) -->
  <section class="section" aria-labelledby="home-process-heading">
    <div class="container">
      <div class="section-heading section-heading--center">
        <p class="eyebrow">{processCopy.eyebrow}</p>
        <h2 id="home-process-heading">{processCopy.heading}</h2>
      </div>
      <Steps />
    </div>
  </section>

  <!-- Final contact: the single short charcoal feature band on this page. -->
  <section class="band--charcoal band--center on-dark" aria-labelledby="home-contact-heading">
    <div class="container">
      <h2 id="home-contact-heading">{finalCopy.heading}</h2>
      <p class="lead">
        {finalCopy.lead}
      </p>
      <div class="cluster">
        <a class="btn btn--gold btn--lg" href={business.phone.href} data-cta="call-final">
          <Icon name="phone" /> Call {business.phone.display}
        </a>
        <a class="btn btn--outline-light btn--lg" href="/contact/" data-cta="request-final">
          Request Service
        </a>
        <a class="hero-alt" href={business.phone.sms} data-cta="text-final">
          <Icon name="message" /> Text Us
        </a>
      </div>
      <TrustChips />
    </div>
  </section>

  <!-- Brands at the bottom (design order). -->
  {
    brands && (
      <section class="section" aria-labelledby="brands-heading">
        <div class="container">
          <div class="section-heading section-heading--center">
            <h2 id="brands-heading">{brands.heading}</h2>
            {brands.lead && <p class="lead">{brands.lead}</p>}
          </div>
          <ul class="brand-list" style="justify-content: center;">
            <li class="brand-box"><img src="/images/brand-carrier.png" alt="Carrier" loading="lazy" width="348" height="150" /></li>
            <li class="brand-box"><img src="/images/brand-goodman.png" alt="Goodman" loading="lazy" width="322" height="135" /></li>
            <li class="brand-box"><img src="/images/brand-lennox.png" alt="Lennox" loading="lazy" width="326" height="93" /></li>
            <li class="brand-box"><img src="/images/brand-rheem.png" alt="Rheem" loading="lazy" width="320" height="315" /></li>
            <li class="brand-box"><img src="/images/brand-ruud.png" alt="Ruud" loading="lazy" width="348" height="217" /></li>
            <li class="brand-box"><img src="/images/brand-trane.png" alt="Trane" loading="lazy" width="280" height="348" /></li>
            <li class="brand-box brand-box--wordmark"><span class="brand-wordmark">Daikin</span></li>
            <li class="brand-box brand-box--more">
              <a href="/services/">
                &amp; More <Icon name="arrow-right" size={18} />
              </a>
            </li>
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
