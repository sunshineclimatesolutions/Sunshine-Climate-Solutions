---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustChips from '../components/TrustChips.astro';
import Steps from '../components/Steps.astro';
import { business, licenseDisplay } from '../config/business';

// Homepage text, SEO metadata, and hero photo are managed in
// src/content/site/home.md (editable via Pages CMS).
const home = await getEntry('site', 'home');
if (!home) throw new Error('Missing src/content/site/home.md');

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const featured = services.slice(0, 2);
const rest = services.slice(2);
const projects = await getCollection('projects');
const reviews = await getCollection('reviews');
const license = licenseDisplay();

const hasHeroImage = Boolean(home.data.heroImage);
---

<BaseLayout title={home.data.metaTitle} description={home.data.metaDescription}>
  <!-- Hero -->
  <section class="hero on-dark">
    <div class="hero-deco" aria-hidden="true">
      <svg viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="200" cy="200" r="150"></circle>
        <circle cx="200" cy="200" r="110" stroke-dasharray="4 14"></circle>
        <circle cx="200" cy="200" r="55"></circle>
        <line x1="200" y1="25" x2="200" y2="50"></line>
        <line x1="200" y1="375" x2="200" y2="350"></line>
        <line x1="25" y1="200" x2="50" y2="200"></line>
        <line x1="375" y1="200" x2="350" y2="200"></line>
        <line x1="306" y1="94" x2="324" y2="76"></line>
        <line x1="94" y1="306" x2="76" y2="324"></line>
        <line x1="306" y1="306" x2="324" y2="324"></line>
        <line x1="94" y1="94" x2="76" y2="76"></line>
      </svg>
    </div>
    <div class={`container hero-inner${hasHeroImage ? ' hero-inner--split' : ''}`}>
      <div class="hero-copy">
        {home.data.heroEyebrow && <p class="eyebrow">{home.data.heroEyebrow}</p>}
        <h1>
          {home.data.heroHeadline}
          {home.data.heroAccent && <span class="accent"> {home.data.heroAccent}</span>}
        </h1>
        {home.data.heroLead && <p class="lead">{home.data.heroLead}</p>}
      <div class="hero-actions">
        <a class="btn btn--gold btn--lg" href={business.phone.href} data-cta="call-hero">
          <Icon name="phone" /> Call {business.phone.display}
        </a>
        <a class="btn btn--outline-light btn--lg" href="/contact/" data-cta="request-hero">
          Request Service
        </a>
        <a class="hero-alt" href={business.phone.sms} data-cta="text-hero">
          <Icon name="message" /> Text Us
        </a>
      </div>
      <p class="offer-chip">
        <strong>{business.pricing.serviceCall} service call</strong>
        <span class="dot" aria-hidden="true">·</span>
        <span>waived when you proceed with the repair</span>
        <span class="dot" aria-hidden="true">·</span>
        <span>Free estimates</span>
      </p>
      <TrustChips />
      </div>
      {
        hasHeroImage && (
          <div class="hero-media">
            <img
              src={home.data.heroImage}
              alt={home.data.heroImageAlt ?? ''}
              width="1600"
              height="1000"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        )
      }
    </div>
  </section>

  <!-- Services -->
  <section class="section section--alt" aria-labelledby="home-services-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Services</p>
        <h2 id="home-services-heading">
          {home.data.servicesHeading ?? 'HVAC service for Tampa Bay homes and businesses'}
        </h2>
        {home.data.servicesIntro && <p class="lead">{home.data.servicesIntro}</p>}
      </div>

      <div class="grid grid--wide">
        {
          featured.map((service) => (
            <ServiceCard
              href={`/services/${service.id}/`}
              title={service.data.title}
              icon={service.data.icon}
              summary={service.data.summary}
            />
          ))
        }
      </div>
      <div class="grid" style="margin-top: var(--sp-md);">
        {
          rest.map((service) => (
            <ServiceCard
              href={`/services/${service.id}/`}
              title={service.data.title}
              icon={service.data.icon}
              summary={service.data.summary}
            />
          ))
        }
        <a class="card card-hover" href="/tab-commissioning-support/" style="background: var(--c-navy); border-color: var(--c-navy);">
          <span class="card-icon"><Icon name="activity" /></span>
          <h3 style="color: #fff;">Testing, Adjusting & Balancing</h3>
          <p style="color: var(--c-on-navy-soft);">
            Air and hydronic TAB, duct traverses, outside-air verification, and commissioning
            support for contractors, engineers, and property teams.
          </p>
          <span class="card-cta" style="color: var(--c-gold);">
            Request a TAB proposal <Icon name="arrow-right" size={18} />
          </span>
        </a>
      </div>
      <p class="muted" style="margin-top: var(--sp-md); font-size: var(--text-sm);">
        We also support contractors with subcontracted installation and overflow work — call to
        talk through scope.
      </p>
    </div>
  </section>

  <!-- Diagnostics strengths -->
  <section class="section" aria-labelledby="home-diag-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Why trust us with your system</p>
        <h2 id="home-diag-heading">Diagnostics done right — airflow, electrical, control boards</h2>
        <p class="lead">
          Many “dead” systems turn out to be a failed capacitor, a stuck contactor, a control-board
          fault, or an airflow problem nobody actually measured. We find the real cause before we
          recommend anything.
        </p>
      </div>
      <div class="grid">
        <div class="card">
          <span class="card-icon"><Icon name="wind" /></span>
          <h3>Airflow and static pressure analysis</h3>
          <p>
            Weak airflow, hot rooms, and humidity trouble usually have measurable causes. We check
            the whole air path, not just the box outside.
          </p>
        </div>
        <div class="card">
          <span class="card-icon"><Icon name="activity" /></span>
          <h3>Electrical and control-board diagnostics</h3>
          <p>
            Control boards, wiring, capacitors, contactors, and sensors — traced methodically
            instead of parts-swapping at your expense.
          </p>
        </div>
        <div class="card">
          <span class="card-icon"><Icon name="clipboard" /></span>
          <h3>Plain-language findings</h3>
          <p>
            You’ll see what we found, what it means, and what your options cost — before any work
            is approved or performed.
          </p>
        </div>
        <div class="card">
          <span class="card-icon"><Icon name="badge" /></span>
          <h3>Owner-operated, EPA Section 608 certified</h3>
          <p>
            You work directly with Aaron — five years of hands-on HVAC experience and a
            repair-first approach that puts the decision in your hands.
          </p>
        </div>
      </div>
      <p class="muted" style="margin-top: var(--sp-md);">
        Want the full story?
        <a href="/about/">More about Aaron and how we work</a>.
      </p>
    </div>
  </section>

  <!-- TAB / professional route -->
  <section class="cta-band on-dark" aria-labelledby="home-tab-heading">
    <div class="container cta-band-inner">
      <div>
        <p class="eyebrow">For contractors, engineers & property teams</p>
        <h2 id="home-tab-heading">Testing, adjusting & balancing, and commissioning support</h2>
        <p>
          Air and hydronic TAB, airflow measurement and balancing reports, duct traverses,
          outside-air verification, building-pressure checks, performance investigation, and
          commissioning support within agreed scope.
        </p>
        <p style="margin-top: var(--sp-2xs); font-size: var(--text-sm);">
          Project scope and certification requirements are reviewed before acceptance.
        </p>
      </div>
      <div class="cta-band-actions">
        <a
          class="btn btn--gold btn--lg"
          href="/contact/?service=tab-commissioning-support"
          data-cta="request-tab-proposal"
        >
          <Icon name="clipboard" /> Request a TAB Proposal
        </a>
        <a class="btn btn--outline-light" href="/tab-commissioning-support/" data-cta="tab-learn-more">
          See TAB services
        </a>
      </div>
    </div>
  </section>

  <!-- Offer band -->
  <section class="band--gold" aria-labelledby="home-offer-heading">
    <div class="container band-inner">
      <div>
        <h2 id="home-offer-heading">
          {business.pricing.serviceCall} service call — waived when you proceed with the repair.
        </h2>
        <p>
          Free estimates, clear options before any work begins, and hours that fit real schedules:
          7:30 AM – 7:30 PM, every day.
        </p>
      </div>
      <div class="cluster">
        <a class="btn btn--navy btn--lg" href={business.phone.href} data-cta="call-offer">
          <Icon name="phone" /> Call {business.phone.display}
        </a>
        <a class="text-link" href="/contact/" data-cta="request-offer" style="color: var(--c-navy);">
          or request service online <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>

  <!-- About + service area -->
  <section class="section" aria-labelledby="home-about-heading">
    <div class="container home-duo">
      <div>
        <p class="eyebrow">About</p>
        <h2 id="home-about-heading">Work directly with the owner</h2>
        <p class="muted" style="margin-top: var(--sp-xs);">
          {home.data.aboutBlurb}
        </p>
        <p style="margin-top: var(--sp-sm);">
          <a class="text-link" href="/about/">
            More about Aaron and our approach <Icon name="arrow-right" size={18} />
          </a>
        </p>
      </div>
      <div>
        <p class="eyebrow">Service area</p>
        <h2>Proudly serving Tampa Bay</h2>
        <ul class="area-list" style="margin-top: var(--sp-sm);">
          {
            business.serviceArea.counties.map((county) => (
              <li class="card" style="padding: 0.9rem 1.1rem; gap: 0.25rem;">
                <strong style="font-family: var(--font-head);">{county}</strong>
              </li>
            ))
          }
        </ul>
        <p class="muted" style="margin-top: var(--sp-sm); font-size: var(--text-sm);">
          {business.serviceArea.centralFloridaNote}
        </p>
        <p style="margin-top: var(--sp-sm);">
          <a class="text-link" href="/service-area/">
            See the full service area <Icon name="arrow-right" size={18} />
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section section--alt" aria-labelledby="home-reviews-heading">
    <div class="container">
      <div class="section-heading" style="text-align: center; margin-inline: auto;">
        <p class="eyebrow">Reviews</p>
        <h2 id="home-reviews-heading">Hear it from customers</h2>
      </div>
      {
        reviews.length > 0 && (
          <div class="grid" style="margin-bottom: var(--sp-lg);">
            {reviews
              .sort((a, b) => a.data.order - b.data.order)
              .slice(0, 3)
              .map((review) => (
                <blockquote class="card">
                  <p>“{review.data.quote}”</p>
                  <footer style="margin-top: auto; font-size: var(--text-sm); color: var(--c-ink-soft);">
                    — {review.data.author}
                    {review.data.context ? `, ${review.data.context}` : ''}
                  </footer>
                </blockquote>
              ))}
          </div>
        )
      }
      <div class="cluster" style="justify-content: center;">
        <a
          class="btn btn--outline-navy btn--lg"
          href={business.reviewsUrl}
          data-cta="reviews-google-home"
          rel="noopener"
        >
          <Icon name="star" /> {business.reviewsLabel}
        </a>
      </div>
      {projects.length > 0 && (
        <p style="text-align: center; margin-top: var(--sp-md);">
          <a class="text-link" href="/our-work/">
            See examples of our work <Icon name="arrow-right" size={18} />
          </a>
        </p>
      )}
    </div>
  </section>

  <!-- Process -->
  <section class="section" aria-labelledby="home-process-heading">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">What happens next</p>
        <h2 id="home-process-heading">What happens after you reach out</h2>
      </div>
      <Steps />
    </div>
  </section>

  <!-- Final contact -->
  <section
    class="section on-dark"
    style="background: var(--c-navy);"
    aria-labelledby="home-contact-heading"
  >
    <div class="container" style="display: grid; gap: var(--sp-md); justify-items: start;">
      <div>
        <h2 id="home-contact-heading" style="color: #fff;">
          {home.data.ctaHeading ?? 'Ready when you are'}
        </h2>
        <p class="lead" style="margin-top: var(--sp-2xs);">
          {home.data.ctaLead ??
            'Call, text, or send a request — we’ll confirm availability with you before anything is scheduled.'}
        </p>
      </div>
      <div class="cluster">
        <a class="btn btn--gold btn--lg" href={business.phone.href} data-cta="call-final">
          <Icon name="phone" /> Call {business.phone.display}
        </a>
        <a class="btn btn--outline-light btn--lg" href="/contact/" data-cta="request-final">
          Request Service
        </a>
        <a class="hero-alt" href={business.phone.sms} data-cta="text-final">
          <Icon name="message" /> Text Us
        </a>
      </div>
      <div class="on-dark">
        <TrustChips />
      </div>
      <p class="form-note" style="color: var(--c-on-navy-soft);">
        {business.pricing.serviceCall} service call, waived when you proceed with the repair · Free
        estimates {license ? `· ${license}` : ''}
      </p>
    </div>
  </section>
</BaseLayout>
