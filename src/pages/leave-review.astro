---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { business } from '../config/business';
import { need } from '../lib/site-content';

const review = await getEntry('site', 'leave-review');
if (!review) throw new Error('[content] src/content/site/leave-review.md is missing');

const hero = need(review.data.hero, 'leave-review.md → hero');
const reviewCta = need(review.data.reviewCta, 'leave-review.md → reviewCta');

const title = review.data.metaTitle;
const description = review.data.metaDescription;
---

<BaseLayout title={title} description={description}>
  <section class="page-hero on-dark">
    <div class="container page-hero-inner">
      <Logo size="lg" />
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.heading}</h1>
      <p class="lead">
        {hero.lead}
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="review-cta-heading">
    <div class="container container--narrow">
      <div class="review-card card">
        <h2 id="review-cta-heading" class="visually-hidden">Leave a Google review</h2>
        <img
          src="/brand/qr-review.png"
          width="560"
          height="560"
          alt="QR code that opens the Sunshine Climate Solutions Google review form"
          loading="lazy"
        />
        <a
          class="btn btn--gold btn--lg"
          href={business.reviewsSubmissionUrl}
          rel="noopener"
          data-cta="leave-review-button"
        >
          <Icon name="star" /> {reviewCta.buttonLabel}
        </a>
        <p class="muted" style="margin-top: var(--sp-sm); text-align: center;">
          {reviewCta.qrNote}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
