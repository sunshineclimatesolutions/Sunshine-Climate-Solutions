---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import TrustChips from '../../components/TrustChips.astro';
import CtaBand from '../../components/CtaBand.astro';
import FieldClip from '../../components/FieldClip.astro';
import { business } from '../../config/business';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const site = Astro.site ?? new URL(business.url);
const canonical = new URL(Astro.url.pathname, site).href;

// Page-level structured data: the visible breadcrumb trail above matches this
// BreadcrumbList, and the Service node describes what this page actually is.
const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Services', item: new URL('/services/', site).href },
      { '@type': 'ListItem', position: 2, name: service.data.title, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.data.title,
    serviceType: service.data.title,
    url: canonical,
    provider: { '@id': new URL('/#business', site).href },
    areaServed: [
      { '@type': 'City', name: 'Spring Hill' },
      ...business.serviceArea.counties.map((c) => ({ '@type': 'AdministrativeArea', name: c })),
      { '@type': 'Place', name: 'Tampa Bay' },
    ],
  },
];
---

<BaseLayout
  title={service.data.metaTitle ?? `${service.data.title} in Tampa Bay`}
  description={service.data.metaDescription}
  schema={pageSchema}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/services/">Services</a></li>
          <li aria-current="page">{service.data.title}</li>
        </ol>
      </nav>
      <p class="eyebrow">Services</p>
      <h1>{service.data.title}</h1>
      <p class="lead">{service.data.summary}</p>
      <div class="cluster" style="margin-top: var(--sp-xs);">
        <a class="btn btn--gold" href={business.phone.href} data-cta={`call-hero-${service.id}`}>
          <Icon name="phone" /> Call {business.phone.display}
        </a>
        <a class="btn btn--navy" href="/contact/" data-cta={`request-hero-${service.id}`}>
          Request Service
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      {
        service.data.evidence &&
          (service.data.evidence.photos.length > 0 || service.data.evidence.clip) && (
            <div class="evidence-strip">
              {service.data.evidence.photos.map((photo) => (
                <figure class="evidence-figure">
                  <Image
                    src={photo.image}
                    alt={photo.alt}
                    widths={[480, 720, 960]}
                    sizes="(min-width: 48em) 21rem, 92vw"
                    loading="lazy"
                    style={photo.position ? `object-position: ${photo.position}` : undefined}
                  />
                  <figcaption>{photo.caption}</figcaption>
                </figure>
              ))}
              {service.data.evidence.clip && (
                <FieldClip
                  src={service.data.evidence.clip.src}
                  poster={service.data.evidence.clip.poster}
                  caption={service.data.evidence.clip.caption}
                />
              )}
            </div>
          )
      }

      <div class="prose">
        <Content />
      </div>

      <div class="callout" style="margin-top: var(--sp-xl);">
        <strong>
          {business.pricing.serviceCall} service call — waived when you proceed with the repair.
          Free estimates.
        </strong>
        <span>
          Work begins only after you approve it. Open 7:30 AM – 7:30 PM, every day.
        </span>
      </div>

      <div style="margin-top: var(--sp-lg);">
        <TrustChips />
      </div>
    </div>
  </section>

  <CtaBand
    context={`service-${service.id}`}
    title="Talk it through with the owner"
    text="Describe the situation and get clear answers about what we found, what it means, and what the available options are."
  />
</BaseLayout>
