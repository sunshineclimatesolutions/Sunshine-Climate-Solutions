---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import CtaBand from '../../components/CtaBand.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const projects = await getCollection('projects');

// Custom multi-color icons (September 2026 design change order).
const serviceIcons: Record<string, string> = {
  'ac-repair-diagnostics': 'wrench-silver',
  'replacement-installation': 'ac-fan',
  'ac-maintenance': 'sparkles-blue',
  'airflow-ductwork': 'airflow-blue',
  'commercial-service-maintenance': 'briefcase-black',
};

const title = 'HVAC Services & AC Repair in Tampa Bay';
const description =
  'AC repair, maintenance, replacement, airflow and ductwork, commercial service, and TAB/commissioning support across Tampa Bay. Free estimates.';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container page-hero-inner page-hero-inner--center">
      <p class="eyebrow">Services</p>
      <h1>Heating and Cooling Services Across Tampa Bay</h1>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="services-list-heading">
    <div class="container">
      <h2 id="services-list-heading" class="visually-hidden">Service details</h2>
      <div class="grid--six">
        {
          services.map((service, index) => (
            <ServiceCard
              href={`/services/${service.id}/`}
              title={service.data.title}
              serviceIcon={serviceIcons[service.id]}
              summary={service.data.summary}
              feature={index === 0}
              center
            />
          ))
        }
        <a
          class="card card-hover card--center svc-tile svc-tile--tab"
          href="/tab-commissioning-support/"
        >
          <span class="card-icon card-icon--custom">
            <ServiceIcon name="checklist" />
          </span>
          <h3>Testing, Adjusting &amp; Balancing</h3>
          <p>
            Air and hydronic TAB, duct traverses, outside-air verification, building-pressure
            checks, and commissioning support for professional teams.
          </p>
          <span class="card-cta">
            Explore TAB support <Icon name="arrow-right" size={18} />
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="maintenance-heading">
    <div class="container home-duo">
      <div class="panel panel--center">
        <p class="eyebrow">Maintenance</p>
        <h2 id="maintenance-heading">Maintenance Without Mystery</h2>
        <p class="muted" style="margin-top: var(--sp-xs);">
          Our <a href="/services/ac-maintenance/">$75 Premium AC Maintenance</a> visit covers
          routine coil cleaning, condensate drain flushing, blower-compartment cleaning and a
          full system check — quoted per system, per visit.
        </p>
      </div>
      <div class="panel panel--center">
        <p class="eyebrow">Contractors & Property Managers</p>
        <h2>Technical Help, on Your Terms</h2>
        <p class="muted" style="margin-top: var(--sp-xs);">
          We support contractors with subcontracted installation and overflow service, and
          professional teams with
          <a href="/tab-commissioning-support/">TAB and commissioning support</a>.
        </p>
        {projects.length > 0 && (
          <p style="margin-top: var(--sp-sm);">
            <a class="text-link" href="/our-work/">
              See examples of our work <Icon name="arrow-right" size={18} />
            </a>
          </p>
        )}
      </div>
    </div>
  </section>

  <CtaBand
    context="services"
    title="Not sure what you need?"
    text="Describe what's going on and we'll help you figure out the right first step. The service call is $50, waived when you proceed with the repair."
  />
</BaseLayout>


