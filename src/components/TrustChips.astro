---
import Icon from './Icon.astro';

// Factual trust signals shown near CTAs and the request form.
// The EPA credential uses the official EPA mark (owner-supplied asset at
// public/images/US-EPA-Logo-1024x1024.png) in place of the generic check
// glyph — the label text stays exactly as before.
interface Chip {
  icon: string;
  label: string;
  /** Optional official mark image rendered instead of the Icon glyph. */
  mark?: string;
}

const chips: Chip[] = [
  { icon: 'flag', label: 'Local Owner-Operator' },
  { icon: 'shield', label: 'Licensed and insured' },
  {
    icon: 'check-circle',
    label: 'EPA Section 608 certified',
    mark: '/images/US-EPA-Logo-1024x1024.png',
  },
  { icon: 'calendar', label: 'Open seven days a week' },
];

interface Props {
  /** "chips" = pill badges; "line" = quiet editorial credibility line. */
  variant?: 'chips' | 'line';
  /** Use the light icon palette when the chips sit on a navy surface. */
  onDark?: boolean;
}
const { variant = 'chips', onDark = false } = Astro.props;
---

{
  variant === 'line' ? (
    <ul class="cred-line">
      {chips.map((c) => (
        <li class="cred-item">
          {c.mark ? (
            <img class="chip-mark" src={c.mark} alt="" width="16" height="16" loading="lazy" />
          ) : (
            <Icon name={c.icon} onDark={onDark} />
          )}{' '}
          {c.label}
        </li>
      ))}
    </ul>
  ) : (
    <div class="chips">
      {chips.map((c) => (
        <span class="chip">
          {c.mark ? (
            <img class="chip-mark" src={c.mark} alt="" width="16" height="16" loading="lazy" />
          ) : (
            <Icon name={c.icon} onDark={onDark} />
          )}{' '}
          {c.label}
        </span>
      ))}
    </div>
  )
}
