---
// Approved Logo 2 (brand-source/originals/logo2.jpg): bold, angular SCS
// letters with a gold stripe. This component shows the LIGHT variant (white
// letters, gold stripe) for the navy header/footer. The full business name
// renders as text beside the mark. Assets: public/brand/logo-light.png
// (regenerate via the process documented in brand-source/ and
// scripts/generate-brand-images.mjs).
interface Props {
  size?: 'md' | 'lg';
}
const { size = 'md' } = Astro.props;
---

<a href="/" class="logo" data-cta="logo-home" aria-label="Sunshine Climate Solutions — home">
  <img
    class={`logo-mark${size === 'lg' ? ' logo-mark--lg' : ''}`}
    src="/brand/logo-light.png"
    width="331"
    height="96"
    alt=""
    aria-hidden="true"
  />
  <span class="logo-name">Sunshine <span>Climate Solutions</span></span>
</a>

<style>
  .logo-mark {
    height: 2.3rem;
    width: auto;
  }

  .logo-mark--lg {
    height: 3.1rem;
  }
</style>
