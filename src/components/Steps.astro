---
// "What happens after you contact us" — keeps the process clear everywhere.
const steps = [
  {
    title: 'Send your request',
    text: 'Call, text, or use the short request form. Tell us what’s going on and where you’re located.',
  },
  {
    title: 'We confirm with you',
    text: 'We contact you to confirm availability. Submitting a request does not book an appointment.',
  },
  {
    title: 'Findings, explained',
    text: 'We evaluate your system on site and go through the readings and findings with you, along with the options and their costs.',
  },
  {
    title: 'You approve the work',
    text: 'The findings and options come first. Nothing is ordered, scheduled, or installed until you approve it.',
  },
];
---

<div class="steps">
  {
    steps.map((step, index) => (
      <div class="step">
        <span class="step-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </div>
    ))
  }
</div>
