---
// Inline icon set.
//
// Two intentionally separate treatments:
//  - Multicolor "utility" icons (phone, message, mail, clipboard, shield,
//    check-circle, check, map-pin, star, flag, calendar, badge, clock, wind,
//    activity, wrench, briefcase, thermometer, sun, bulb, share, users, heart)
//    carry their own SVG fills/strokes, layered in the brand palette (navy +
//    blue + restrained gold + functional green/red). Palette variables flip
//    for dark surfaces via `onDark` — artwork stays identical.
//  - Compact UI glyphs (arrows, chevrons, menu, close, alert) stay
//    single-color `currentColor` strokes so they inherit surrounding text.
interface Props {
  name: string;
  size?: number;
  class?: string;
  /** Render the light palette variant for use on navy/dark surfaces. */
  onDark?: boolean;
}
const { name, size = 24, class: className, onDark = false } = Astro.props;

// Multi-color utility artwork. Colors resolve from the .icon palette tokens
// defined in global.css; fills/strokes live in the artwork itself.
const colorIcons: Record<string, string> = {
  phone:
    '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" fill="var(--ui-navy)"/><path d="M15.7 4.4a5.3 5.3 0 0 1 3.9 3.9" fill="none" stroke="var(--ui-blue)" stroke-width="1.8" stroke-linecap="round"/>',
  message:
    '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" fill="var(--ui-navy)"/><circle cx="8" cy="10" r="1.25" fill="var(--ui-blue-soft)"/><circle cx="12" cy="10" r="1.25" fill="var(--ui-blue-soft)"/><circle cx="16" cy="10" r="1.25" fill="var(--ui-blue-soft)"/>',
  mail:
    '<rect x="2.5" y="5" width="19" height="14" rx="2.2" fill="var(--ui-navy)"/><path d="M4.7 7.4l7.3 5.3 7.3-5.3" fill="none" stroke="var(--ui-blue-soft)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>',
  clipboard:
    '<rect x="5" y="4" width="14" height="17.2" rx="2.2" fill="var(--ui-navy)"/><rect x="8.8" y="2.4" width="6.4" height="3.6" rx="1.4" fill="var(--ui-silver)" stroke="var(--ui-steel)" stroke-width="1"/><path d="M8.6 10.2h6.8" fill="none" stroke="var(--ui-blue-soft)" stroke-width="1.6" stroke-linecap="round"/><path d="M8.6 13.6h6.8" fill="none" stroke="var(--ui-blue-soft)" stroke-width="1.6" stroke-linecap="round"/><path d="M8.6 17h4" fill="none" stroke="var(--ui-gold)" stroke-width="1.8" stroke-linecap="round"/>',
  shield:
    '<path d="M12 21.5s7.6-3.8 7.6-9.5V5.2L12 2.4 4.4 5.2V12c0 5.7 7.6 9.5 7.6 9.5z" fill="var(--ui-navy)"/><path d="M8.6 11.9l2.6 2.6 4.4-5" fill="none" stroke="var(--ui-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  'check-circle':
    '<circle cx="12" cy="12" r="9" fill="none" stroke="var(--ui-blue)" stroke-width="2"/><path d="M8.2 12.4l2.7 2.7 5.2-6" fill="none" stroke="var(--ui-green)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>',
  check:
    '<path d="M5 12.6l4.4 4.4L19 7.4" fill="none" stroke="var(--ui-green)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>',
  'map-pin':
    '<path d="M21 10c0 6.8-9 12.6-9 12.6S3 16.8 3 10a9 9 0 0 1 18 0z" fill="var(--ui-blue)"/><circle cx="12" cy="10" r="3.4" fill="var(--ui-white)"/><circle cx="12" cy="10" r="1.4" fill="var(--ui-blue)"/>',
  star:
    '<polygon points="12 2.4 15 8.3 21.6 9.3 16.8 14 17.9 20.6 12 17.5 6.1 20.6 7.2 14 2.4 9.3 9 8.3" fill="var(--ui-gold)" stroke="var(--ui-navy)" stroke-width="1" stroke-linejoin="round"/>',
  flag:
    '<rect x="3" y="6.5" width="18" height="11" rx="0.8" fill="var(--ui-red)"/><rect x="3" y="8.1" width="18" height="1.5" fill="#ffffff"/><rect x="3" y="11.2" width="18" height="1.5" fill="#ffffff"/><rect x="3" y="14.4" width="18" height="1.5" fill="#ffffff"/><rect x="3" y="6.5" width="7.2" height="4.6" fill="var(--ui-canton)"/><circle cx="4.4" cy="7.4" r="0.45" fill="#ffffff"/><circle cx="6.6" cy="7.4" r="0.45" fill="#ffffff"/><circle cx="8.8" cy="7.4" r="0.45" fill="#ffffff"/><circle cx="5.5" cy="8.6" r="0.45" fill="#ffffff"/><circle cx="7.7" cy="8.6" r="0.45" fill="#ffffff"/><circle cx="4.4" cy="9.8" r="0.45" fill="#ffffff"/><circle cx="6.6" cy="9.8" r="0.45" fill="#ffffff"/><circle cx="8.8" cy="9.8" r="0.45" fill="#ffffff"/>',
  calendar:
    '<rect x="3.5" y="5.2" width="17" height="15.6" rx="2" fill="var(--ui-white)" stroke="var(--ui-navy)" stroke-width="1.6"/><path d="M3.5 9.4h17" stroke="var(--ui-navy)" stroke-width="1.6"/><path d="M8 3.6v3.2M16 3.6v3.2" stroke="var(--ui-navy)" stroke-width="2" stroke-linecap="round"/><path d="M9.7 12.4h5l-2.7 5.9" fill="none" stroke="var(--ui-blue)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>',
  clock:
    '<circle cx="12" cy="12" r="9" fill="none" stroke="var(--ui-navy)" stroke-width="1.8"/><path d="M12 7.2V12l3.4 2" fill="none" stroke="var(--ui-blue)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>',
  badge:
    '<path d="M12 21.6s7.3-3.6 7.3-9.1V5.4L12 2.6 4.7 5.4v7.1c0 5.5 7.3 9.1 7.3 9.1z" fill="var(--ui-navy)"/><path d="M8.7 11.9l2.5 2.5 4.2-4.8" fill="none" stroke="var(--ui-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  wind:
    '<g fill="none" stroke-linecap="round"><path d="M3.5 8.2h11a2.6 2.6 0 1 0-2.6-2.6" stroke="var(--ui-blue-soft)" stroke-width="1.9"/><path d="M3.5 12.4h14.5a2.8 2.8 0 1 1-2.8 2.8" stroke="var(--ui-blue)" stroke-width="2.1"/><path d="M3.5 16.6h8.5a2.4 2.4 0 1 1-2.4 2.4" stroke="var(--ui-blue-soft)" stroke-width="1.9"/></g>',
  activity:
    '<polyline points="21.5 12 17.8 12 14.8 20.5 9.2 3.5 6.2 12 2.5 12" fill="none" stroke="var(--ui-blue)" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.2" cy="3.5" r="1.7" fill="var(--ui-gold)"/>',
  wrench:
    '<path d="M14.3 6.6a1 1 0 0 0 0 1.4l1.7 1.7a1 1 0 0 0 1.4 0l4-4a6.3 6.3 0 0 1-8.3 8.3l-7.2 7.2a2.2 2.2 0 0 1-3.1-3.1l7.2-7.2a6.3 6.3 0 0 1 8.3-8.3z" fill="var(--ui-silver)" stroke="var(--ui-steel)" stroke-width="1.6" stroke-linejoin="round"/>',
  briefcase:
    '<rect x="2.8" y="7.4" width="18.4" height="12.8" rx="2" fill="var(--ui-navy)"/><path d="M8.8 7.4V5.6a1.8 1.8 0 0 1 1.8-1.8h2.8a1.8 1.8 0 0 1 1.8 1.8v1.8" fill="none" stroke="var(--ui-steel)" stroke-width="1.9" stroke-linecap="round"/><rect x="10.4" y="11.9" width="3.2" height="3" rx="0.8" fill="var(--ui-silver)"/>',
  thermometer:
    '<path d="M14 14.76V4.2a2.5 2.5 0 0 0-5 0v10.56a4.5 4.5 0 1 0 5 0z" fill="none" stroke="var(--ui-navy)" stroke-width="1.8" stroke-linejoin="round"/><circle cx="11.5" cy="17.2" r="2.6" fill="var(--ui-red)"/><path d="M11.5 9.5v7" stroke="var(--ui-red)" stroke-width="2.2" stroke-linecap="round"/>',
  sun:
    '<circle cx="12" cy="12" r="4.4" fill="var(--ui-gold)"/><g stroke="var(--ui-gold-deep)" stroke-width="1.9" stroke-linecap="round"><path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"/></g>',
  bulb:
    '<path d="M12 2.6a6.6 6.6 0 0 0-3.8 12v2.1h7.6v-2.1A6.6 6.6 0 0 0 12 2.6z" fill="var(--ui-gold)"/><path d="M9.4 19h5.2M10.2 21.4h3.6" stroke="var(--ui-steel)" stroke-width="1.8" stroke-linecap="round"/>',
  share:
    '<path d="M8.4 10.8l7.2-3.5M8.4 13.2l7.2 3.5" stroke="var(--ui-navy)" stroke-width="1.6"/><circle cx="18" cy="5.4" r="2.8" fill="var(--ui-blue)"/><circle cx="6" cy="12" r="2.8" fill="var(--ui-blue)"/><circle cx="18" cy="18.6" r="2.8" fill="var(--ui-blue)"/>',
  users:
    '<circle cx="9" cy="8.2" r="3.4" fill="var(--ui-navy)"/><path d="M3.4 19.4c0-3.1 2.5-5.4 5.6-5.4s5.6 2.3 5.6 5.4z" fill="var(--ui-navy)"/><circle cx="16.9" cy="9" r="2.7" fill="var(--ui-blue-soft)"/><path d="M16.4 14.6c2.6.3 4.4 2.3 4.4 4.8h-3.5" fill="var(--ui-blue-soft)"/>',
  heart:
    '<path d="M20.8 4.9a5.4 5.4 0 0 0-7.7 0L12 6l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7l1.1 1.1 7.7 7.7 7.7-7.7 1.1-1.1a5.4 5.4 0 0 0 0-7.7z" fill="var(--ui-red)" stroke="var(--ui-navy)" stroke-width="0.9" stroke-linejoin="round"/>',
};

// Single-color UI glyphs (inherit surrounding text color).
const glyphs: Record<string, string> = {
  'chevron-down': '<polyline points="6 9 12 15 18 9"/>',
  'chevron-left': '<polyline points="15 18 9 12 15 6"/>',
  'chevron-right': '<polyline points="9 18 15 12 9 6"/>',
  'arrow-right': '<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>',
  menu: '<line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>',
  x: '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>',
  'alert-circle':
    '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>',
};

const colorArtwork = colorIcons[name];
const glyph = glyphs[name] ?? '';
---

{
  colorArtwork ? (
    <svg
      class={`icon icon--color${onDark ? ' icon--on-dark' : ''} ${className ?? ''}`.trim()}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
      set:html={colorArtwork}
    />
  ) : (
    <svg
      class={`icon ${className ?? ''}`.trim()}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={glyph}
    />
  )
}
