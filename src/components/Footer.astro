---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import ScsSignature from './ScsSignature.astro';
import { business, licenseDisplay } from '../config/business';

const projects = await getCollection('projects');
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
const license = licenseDisplay();

// The persistent way to revisit the analytics consent choice. Shown only when
// the consent interface exists (GTM configured, not a preview build).
const consentUi = Boolean(business.analytics.gtm.containerId) &&
  import.meta.env.PUBLIC_PREVIEW_MODE !== 'true';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo size="lg" />
        <div class="footer-brand-top">
          <p>
            Owner-operated heating and cooling service for Tampa Bay homes and businesses. Clear
            explanations, straightforward options, and a repair-first approach.
          </p>
          <ScsSignature size={56} class="footer-signature" />
        </div>
        <a
          class="footer-reviews"
          href={business.reviewsUrl}
          data-cta="reviews-footer"
          rel="noopener"
        >
          <img class="google-g" src="/brand/google-g.svg" alt="" width="26" height="26" />
          Read Our Google Reviews
        </a>
        <div class="footer-review-invite">
          <p>Been a Customer? We’d Appreciate Your Honest Review.</p>
          <a class="footer-review-cta" href="/leave-review/" data-cta="leave-review-footer">
            <img class="google-g" src="/brand/google-g.svg" alt="" width="26" height="26" />
            Leave a Google Review
          </a>
        </div>
        <SocialLinks compact />
        <p class="license-line">
          <Icon name="badge" /> Licensed and insured · EPA Section 608 certified
        </p>
      </div>

      <div>
        <h2 class="footer-heading">Services</h2>
        <ul class="footer-links">
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.id}/`}>{s.data.title}</a>
              </li>
            ))
          }
          <li><a href="/tab-commissioning-support/">TAB & Commissioning</a></li>
          {projects.length > 0 && <li><a href="/our-work/">Our Work</a></li>}
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Company</h2>
        <ul class="footer-links">
          <li><a href="/about/">About</a></li>
          <li><a href="/service-area/">Service Area</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/support/">Support Our Growth</a></li>
          {consentUi && (
            <li>
              <button type="button" class="footer-consent" data-consent-open>
                Analytics preferences
              </button>
            </li>
          )}
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Get in touch</h2>
        <div class="footer-contact">
          <a href={business.phone.href} data-cta="call-footer">
            <Icon name="phone" /> {business.phone.display}
          </a>
          <a href={business.phone.sms} data-cta="text-footer">
            <Icon name="message" /> Text us
          </a>
          <a href={`mailto:${business.email}`} data-cta="email-footer">
            <Icon name="mail" /> {business.email}
          </a>
          <p class="fc-meta">
            <span class="fc-line">
              <Icon name="clock" /> {business.hours.display} · {business.hours.days}
            </span>
            <span class="fc-line">
              <Icon name="map-pin" /> Hernando · Pasco · Pinellas · Hillsborough
            </span>
          </p>
          <p class="fc-meta">We accept {business.payments.accepted.join(', ').toLowerCase()}.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {year} {business.legalName}. All rights reserved.</p>
      {license ? <p class="license">{license}</p> : <p>Independently Owned · Repair-First</p>}
    </div>
  </div>
</footer>

<style>
  .fc-line {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
</style>
