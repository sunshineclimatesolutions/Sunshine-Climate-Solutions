---
// Verified social/directory profile links — rendered from the centralized
// config in src/config/business.ts; never hard-code URLs here.
//
// Presentation (September 2026 social expansion):
//  - Facebook / Nextdoor / Yelp keep their owner-supplied full-color brand
//    graphics (public/images/), used unmodified and height-balanced.
//  - Instagram / TikTok / YouTube / X use official Simple Icons glyphs inlined
//    by SocialIcon.astro (local SVGs in public/images/social/, CC0) in the
//    platform's primary brand color, so they sit consistently beside the
//    existing colored logos.
//  - Gab uses its official downloadable wordmark (public/images/social/gab.svg,
//    from the Gab brand assets page), used unmodified.
//  - Parler uses its official social icon (public/images/social/parler.svg,
//    from the parler.com site assets), used unmodified.
//  - Outbound profile links only: never append inbound campaign UTMs here.
//  - The visible platform label carries the meaning (logos/glyphs are
//    decorative, alt="" / aria-hidden).
//  - LinkedIn uses the owner-supplied official "in" mark
//    (public/images/linkedin-logo.webp) with its white margin trimmed so it
//    matches the other icons' optical size.
// Yelp is presented as a neutral business-directory link only — no Yelp
// review solicitation anywhere (see business.ts).
import { business } from '../config/business';
import SocialIcon from './SocialIcon.astro';

interface Props {
  /** Optional compact modifier for tighter placements (footer). */
  compact?: boolean;
  /** Platform labels to omit in a specific placement (e.g. ['yelp']). */
  exclude?: string[];
}

const { compact = false, exclude = [] } = Astro.props;

type Profile =
  | {
      href: string;
      label: string;
      kind: 'img';
      img: string;
      width: number;
      height: number;
      tileOnDark: boolean;
    }
  | {
      href: string;
      label: string;
      kind: 'icon';
      icon: string;
      tileOnDark: boolean;
    };

const allProfiles: Profile[] = [
  {
    href: business.social.facebook,
    label: 'Facebook',
    kind: 'img',
    img: '/images/Facebook_logo.webp',
    width: 128,
    height: 128,
    tileOnDark: false,
  },
  {
    href: business.social.instagram,
    label: 'Instagram',
    kind: 'icon',
    icon: 'instagram',
    tileOnDark: false,
  },
  {
    href: business.social.tiktok,
    label: 'TikTok',
    kind: 'icon',
    icon: 'tiktok',
    // Black glyph — needs a light tile on dark surfaces to stay legible.
    tileOnDark: true,
  },
  {
    href: business.social.youtube,
    label: 'YouTube',
    kind: 'icon',
    icon: 'youtube',
    tileOnDark: false,
  },
  {
    href: business.social.x,
    label: 'X',
    kind: 'icon',
    icon: 'x',
    // Black glyph — needs a light tile on dark surfaces to stay legible.
    tileOnDark: true,
  },
  {
    href: business.social.linkedin,
    label: 'LinkedIn',
    kind: 'img',
    // Official LinkedIn "in" mark (owner-supplied asset; white margin trimmed).
    img: '/images/linkedin-logo.webp',
    width: 512,
    height: 513,
    tileOnDark: false,
  },
  {
    href: business.social.nextdoor,
    label: 'Nextdoor',
    kind: 'img',
    img: '/images/nextdoor_logo.png',
    width: 256,
    height: 133,
    tileOnDark: false,
  },
  {
    href: business.social.yelp,
    label: 'Yelp',
    kind: 'img',
    img: '/images/yelp-logo-3519.png',
    width: 280,
    height: 113,
    // Black wordmark — needs a light tile on navy surfaces to stay legible.
    tileOnDark: true,
  },
  {
    href: business.social.gab,
    label: 'Gab',
    kind: 'img',
    // Official Gab wordmark (Gab brand assets page), used unmodified.
    img: '/images/social/gab.svg',
    width: 50,
    height: 30,
    tileOnDark: false,
  },
  {
    href: business.social.parler,
    label: 'Parler',
    kind: 'img',
    // Official Parler social icon (parler.com site assets), used unmodified.
    img: '/images/social/parler.svg',
    width: 139,
    height: 139,
    tileOnDark: false,
  },
];

const profiles = allProfiles.filter(
  (profile) => profile.href && !exclude.includes(profile.label.toLowerCase()),
);
---

{
  profiles.length > 0 && (
    <ul class={`social-links${compact ? ' social-links--compact' : ''}`}>
      {profiles.map((profile) => (
        <li>
          <a
            href={profile.href}
            target="_blank"
            rel="noopener noreferrer"
            data-cta={`social-${profile.label.toLowerCase()}`}
          >
            {profile.kind === 'img' ? (
              <img
                class={`social-logo${profile.tileOnDark ? ' social-logo--tile-on-dark' : ''}`}
                src={profile.img}
                alt=""
                width={profile.width}
                height={profile.height}
                loading="lazy"
              />
            ) : (
              <SocialIcon
                name={profile.icon}
                class={profile.tileOnDark ? 'social-logo--tile-on-dark' : ''}
              />
            )}
            {profile.label}
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
