---
// Verified social/directory profile links (Facebook, Nextdoor, Yelp) —
// rendered from the centralized config in src/config/business.ts; never
// hard-code URLs here. Logos are owner-supplied brand graphics
// (public/images/), used unmodified and height-balanced; the visible platform
// label carries the meaning (logos are decorative, alt="").
// Yelp is presented as a neutral business-directory link only — no Yelp
// review solicitation anywhere (see business.ts).
import { business } from '../config/business';

interface Props {
  /** Optional compact modifier for tighter placements (footer). */
  compact?: boolean;
  /** Platform labels to omit in a specific placement (e.g. ['yelp']). */
  exclude?: string[];
}

const { compact = false, exclude = [] } = Astro.props;

const profiles = [
  {
    href: business.social.facebook,
    label: 'Facebook',
    img: '/images/Facebook_logo.webp',
    width: 128,
    height: 128,
    tileOnDark: false,
  },
  {
    href: business.social.nextdoor,
    label: 'Nextdoor',
    img: '/images/nextdoor_logo.png',
    width: 256,
    height: 133,
    tileOnDark: false,
  },
  {
    href: business.social.yelp,
    label: 'Yelp',
    img: '/images/yelp-logo-3519.png',
    width: 280,
    height: 113,
    // Black wordmark — needs a light tile on navy surfaces to stay legible.
    tileOnDark: true,
  },
].filter((profile) => profile.href && !exclude.includes(profile.label.toLowerCase()));
---

{
  profiles.length > 0 && (
    <ul class={`social-links${compact ? ' social-links--compact' : ''}`}>
      {profiles.map((profile) => (
        <li>
          <a
            href={profile.href}
            target="_blank"
            rel="noopener noreferrer"
            data-cta={`social-${profile.label.toLowerCase()}`}
          >
            <img
              class={`social-logo${profile.tileOnDark ? ' social-logo--tile-on-dark' : ''}`}
              src={profile.img}
              alt=""
              width={profile.width}
              height={profile.height}
              loading="lazy"
            />
            {profile.label}
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
