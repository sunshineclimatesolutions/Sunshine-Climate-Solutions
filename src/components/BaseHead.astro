---
import { business } from '../config/business';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  // Optional page-level structured data (Service, BreadcrumbList, …) rendered
  // as additional JSON-LD blocks alongside the global HVACBusiness entity.
  schema?: object[];
}

const { title, description, noindex = false, schema = [] } = Astro.props;

const site = Astro.site ?? new URL(business.url);
const path = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(path, site).href;

// Preview deployments set PUBLIC_PREVIEW_MODE=true so they are never indexed.
// The production deployment must leave it unset/false (see docs/DEPLOYMENT.md).
const preview = import.meta.env.PUBLIC_PREVIEW_MODE === 'true';
const robots = noindex || preview ? 'noindex, follow' : 'index, follow';

// Umami Cloud analytics (cookieless, aggregate only). Loads only when a website
// ID is configured and never in preview mode — preview/test traffic cannot
// pollute the dashboard. Click events send fixed names only; no personal
// information is ever transmitted (rule documented in AGENTS.md).
const umamiId = business.analytics.umami.websiteId;
const umamiEnabled = Boolean(umamiId) && !preview;

// Google Tag Manager (GA4). Same preview guard as Umami so test traffic never
// reaches Google. Consent Mode v2 defaults are set (all denied) BEFORE the
// container snippet loads; only the visitor's explicit choice can grant
// analytics storage, and advertising consent is never granted by this site.
const gtmId = business.analytics.gtm.containerId;
const gtmEnabled = Boolean(gtmId) && !preview;

const pageTitle = title.includes(business.name) ? title : `${title} | ${business.name}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HVACBusiness',
  '@id': new URL('/#business', site).href,
  name: business.name,
  legalName: business.legalName,
  url: business.url,
  telephone: business.phone.e164,
  email: business.email,
  image: new URL('/brand/icon-512.png', site).href,
  logo: new URL('/brand/icon-512.png', site).href,
  priceRange: '$$',
  // The owner's name is intentionally NOT published: the optional `founder`
  // Person property is omitted rather than replaced with a fictitious name
  // (September 2026 anonymity directive).
  // Verified public business profiles only (config-driven; no invented
  // profiles). Empty values (pending LinkedIn / Parler) are filtered out.
  // Google review links live in business.reviewsUrl / reviewsSubmissionUrl and
  // are intentionally NOT part of sameAs; the clean canonical profile URLs are
  // used here — never the tracked website-return (UTM) links.
  sameAs: Object.values(business.social).filter(Boolean),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
        'Sunday',
      ],
      opens: business.hours.schema.opens,
      closes: business.hours.schema.closes,
    },
  ],
  areaServed: [
    // Primary market first (Spring Hill), then the confirmed service counties.
    { '@type': 'City', name: 'Spring Hill' },
    ...business.serviceArea.counties.map((c) => ({ '@type': 'AdministrativeArea', name: c })),
    { '@type': 'Place', name: 'Tampa Bay' },
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta name="theme-color" content="#2d4256" />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
<link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/brand/icon-180.png" />

<link
  rel="preload"
  href="/fonts/archivo-var-latin.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/publicsans-var-latin.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<meta property="og:site_name" content={business.name} />
<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL('/brand/og-default.png', site).href} />
<meta name="twitter:card" content="summary_large_image" />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

{
  schema.map((node) => (
    <script type="application/ld+json" set:html={JSON.stringify(node)} />
  ))
}

{
  gtmEnabled && (
    <script
      is:inline
      set:html={`(function () {
  // ── Basic Consent Mode (September 2026 correction) ────────────────────────
  // The GTM container and GA4 are NOT loaded, and no request is made to
  // Google, until the visitor explicitly allows analytics. Consent Mode v2
  // defaults (all denied, advertising always denied) are established first,
  // then a stored or newly given permission is applied BEFORE GTM loads.
  // Any storage/parse failure fails closed: nothing loads.
  var GTM_ID = '${gtmId}';
  var GA4_ID = 'G-EQ9CBESN23';
  var KEY = 'scs-consent-v1';

  window.dataLayer = window.dataLayer || [];
  function gtag() { window.dataLayer.push(arguments); }
  window.gtag = gtag;
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
  });

  var granted = false;
  var gtmLoaded = false;

  function readStored() {
    try {
      var stored = JSON.parse(window.localStorage.getItem(KEY) || 'null');
      if (stored && typeof stored.analytics === 'boolean') return stored.analytics;
    } catch (error) { /* fail closed */ }
    return null;
  }

  function writeStored(analytics) {
    try {
      window.localStorage.setItem(KEY, JSON.stringify({ analytics: !!analytics, v: 1 }));
    } catch (error) { /* the in-memory state still applies */ }
  }

  function loadGtm() {
    if (gtmLoaded || document.querySelector('script[src*="googletagmanager.com/gtm.js"]')) {
      gtmLoaded = true;
      return;
    }
    gtmLoaded = true;
    window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
    document.head.appendChild(script);
  }

  // A confirmed form submission (Web3Forms success) leaves a single-use
  // receipt. It is transmitted at most once, only with permission:
  //  - permission already given: fire now and consume it;
  //  - permission refused: drop it (never transmit);
  //  - undecided: keep it pending for the consent choice on this visit.
  function firePendingLead() {
    try {
      var raw = window.sessionStorage.getItem('scs-lead-receipt');
      if (!raw) return;
      if (readStored() === false) {
        window.sessionStorage.removeItem('scs-lead-receipt');
        return;
      }
      if (!granted) return;
      window.sessionStorage.removeItem('scs-lead-receipt');
      var receipt = JSON.parse(raw);
      window.dataLayer.push({
        event: 'scs_form_confirmed',
        service_category: receipt.service_category || 'other',
        cta_slot: receipt.cta_slot || 'form-submit',
      });
    } catch (error) { /* fail closed */ }
  }

  function allow() {
    granted = true;
    writeStored(true);
    window['ga-disable-' + GA4_ID] = false;
    gtag('consent', 'update', { analytics_storage: 'granted' });
    loadGtm();
    firePendingLead();
  }

  function deny() {
    granted = false;
    writeStored(false);
    gtag('consent', 'update', { analytics_storage: 'denied' });
    // Stop any already-loaded Google tag from collecting further data.
    window['ga-disable-' + GA4_ID] = true;
    // Withdrawal/refusal also drops any pending confirmed lead.
    try { window.sessionStorage.removeItem('scs-lead-receipt'); } catch (error) { /* no-op */ }
  }

  // Single shared consent API for the banner, the event trackers and the
  // thank-you receipt consumer. Advertising consent is never granted.
  window.scsConsent = {
    granted: function () { return granted; },
    choice: readStored,
    allow: allow,
    deny: deny,
    firePendingLead: firePendingLead
  };

  // Returning consenting visitors: apply the granted state BEFORE loading GTM
  // (no repeat prompt). Everyone else stays unloaded and denied.
  if (readStored() === true) allow();
})();`}
    />
  )
}

{
  (umamiEnabled || gtmEnabled) && (
    <script
      is:inline
      set:html={`document.addEventListener('click', function (event) {
  var link = event.target.closest('a[href]');
  if (!link) return;
  var href = link.getAttribute('href') || '';
  var slot = link.getAttribute('data-cta') || '';

  // GTM data-layer events: fixed names + allowlisted CTA slot only. Never the
  // href, phone number, or any form content. Basic Consent Mode: events are
  // only pushed after analytics permission, so nothing from before permission
  // can ever be replayed when GTM loads.
  var eventName = '';
  if (href.indexOf('tel:') === 0) eventName = 'scs_call_click';
  else if (href.indexOf('sms:') === 0) eventName = 'scs_text_click';
  else if (slot.indexOf('request-') === 0) eventName = 'scs_request_click';
  if (eventName && window.scsConsent && window.scsConsent.granted()) {
    var payload = { event: eventName };
    if (slot) payload.cta_slot = slot;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push(payload);
  }

  // Umami stays cookieless and unchanged (fixed names only).
  if (!window.umami) return;
  if (href.indexOf('tel:') === 0) window.umami.track('call-click');
  else if (href.indexOf('sms:') === 0) window.umami.track('text-click');
}, { capture: true });`}
    />
  )
}

{
  umamiEnabled && (
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={umamiId} />
  )
}
