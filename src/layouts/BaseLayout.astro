---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { business } from '../config/business';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: object[];
}

const { title, description, noindex = false, schema = [] } = Astro.props;

// Same enable rule as BaseHead: no GTM (and no consent UI) in preview builds.
const gtmEnabled =
  Boolean(business.analytics.gtm.containerId) &&
  import.meta.env.PUBLIC_PREVIEW_MODE !== 'true';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} schema={schema} />
  </head>
  <body>
    {/* Basic Consent Mode: no GTM <noscript> iframe. Loading the container
        without JavaScript would transmit before any consent choice, so it is
        intentionally omitted (Google's noscript snippet is optional). */}
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
    {gtmEnabled && <ConsentBanner />}
    {/* Consent-aware first/latest-touch campaign capture for LEAD RECORDS only
        (never analytics); best-effort and non-blocking — see
        src/lib/attribution.ts. Declined/withdrawn consent stores nothing. */}
    <script>
      import { initAttribution } from '../lib/attribution';
      initAttribution();
    </script>
  </body>
</html>
