# Sunshine Climate Solutions - environment configuration
# Copy to .env for local overrides. Everything here is PUBLIC, client-side data.

# Web3Forms public access key (client-side submission identifier - safe to expose).
# A working default is committed in src/config/business.ts.
# Set this ONLY to override that value (e.g. after rotating the key at web3forms.com).
# Get a key: https://web3forms.com
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Set to "true" ONLY for preview deployments that must not be indexed
# (adds noindex meta tags and a Disallow-all robots.txt).
# MUST be unset or "false" for the production deployment.
PUBLIC_PREVIEW_MODE=false
