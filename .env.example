# Sunshine Climate Solutions - environment configuration
# Copy to .env for local overrides. Everything here is PUBLIC, client-side data.

# Web3Forms public access key (client-side submission identifier - safe to expose).
# A working default is committed in src/config/business.ts.
# Set this ONLY to override that value (e.g. after rotating the key at web3forms.com).
# Get a key: https://web3forms.com
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Set to "true" ONLY for preview deployments that must not be indexed
# (adds noindex meta tags and a Disallow-all robots.txt).
# MUST be unset or "false" for the production deployment.
PUBLIC_PREVIEW_MODE=false

# Umami Cloud website ID (cookieless aggregate analytics - public client-side
# identifier, safe to expose). The production ID is committed in
# src/config/business.ts. Set this ONLY to override it; set it to an EMPTY
# value to disable analytics in a given environment.
# Events are fixed-name only (call-click, text-click, form-success) - never
# send personal information or form contents to analytics.
PUBLIC_UMAMI_WEBSITE_ID=

# Google Tag Manager container ID (loads GA4; the GA4 measurement ID is
# configured INSIDE the container). Public client-side identifier, safe to
# expose. The production ID is committed in src/config/business.ts. Set this
# ONLY to override it; set it to an EMPTY value to disable GTM and the consent
# banner in a given environment. Consent Mode v2 defaults are all-denied and
# only an explicit visitor choice grants analytics storage (see
# src/components/ConsentBanner.astro and docs/GTM-GA4-SETUP.md).
PUBLIC_GTM_CONTAINER_ID=
